                    if (frontend.catalogViewTracker && frontend.catalogViewTracker.trackMapView) {
                        frontend.catalogViewTracker.trackMapView(item.id);
                    }
                });
			});

			if (mapYandex.marks.length > 0) {
				mapYandex.cluster = new ymaps.Clusterer({
					clusterDisableClickZoom: true,
					balloonContentLayoutHeight: 150
