$(document).keyup(function(e){
	if (e.keyCode == 27) {
		var $modal = $('body > .modal').last();
		
		if($modal.triggerHandler ('escape')===false) return;
		
		$modal.modal('hide');
	}
});

var metric = {
    key: null,
    initialized: false,
    send: function (goal, params = {}) {
        if (!metric.key) return;
        if (typeof ym !== 'function') return;

        if (!metric.initialized) {
            ym(metric.key, 'init', {
                clickmap: true,
                trackLinks: true,
                accurateTrackBounce: true
            });
            metric.initialized = true;
        }

        goal = 'ym_dikidi_' + goal;
        ym(metric.key, 'reachGoal', goal, params);
    }
};

function sendGlobalBookingCta() {
    if (typeof ym !== 'function' || !window.METRIKA_ID) return;

    var params = {};
    if (window.frontend && frontend.company && frontend.company.id) {
        params.company_id = frontend.company.id;
    }

    ym(window.METRIKA_ID, 'reachGoal', 'booking-cta', params);
}

