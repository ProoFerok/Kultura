            const oldFilters = $('.mobile-elements-select');
            const isMaster = $('input[name=is_master]').val();
            $('input[name=reviews_list_only_photo]').prop('checked', false)
            
            newFilters.each(function () {
                const $select = $(this);
                
                if (parseInt(isMaster) && $select.context.className.includes('masters')) {
                    return
                }
                
                const $options = $select.find('option');
                $options.prop('selected', false);
                
                $select.find('.button > .text').text($options[0].textContent.trim());
                $select.find('.list').removeClass('active');
                $select.find('.list > .elements > .option.active').removeClass('active');
                $options.eq(0).addClass('active');
            });

            oldFilters.each(function () {
                const $select = $(this);

                if (parseInt(isMaster) && $select.context.className.includes('masters')) {
                    return
                }
                
                const $options = $select.find('ul > li');
                const $optionsHide = $select.find('option');

                $optionsHide.prop('selected', false);
                $optionsHide.first().prop('selected', true);
                
                $select.find('.filter-option.pull-left').text($options[0].textContent.trim());
                $options.removeClass('selected');
                $options.eq(0).addClass('selected');
            });
        });
	},
