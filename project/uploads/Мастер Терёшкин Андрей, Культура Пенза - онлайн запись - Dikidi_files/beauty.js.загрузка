// Вверх/Вниз
$(document).ready(function(){
	var $rootContainer = $('#root-container'),
		$scrollTopPageBtn = $('#scroll-top-page-btn'),
		minScrollTop = 0,
		maxScrollTop = minScrollTop + $(window).height() / 2,
		originalScrollTop = null,
		isAnimated= false;

	$scrollTopPageBtn.click(function(){
		if(isAnimated) {
			return;
		}

		isAnimated = true;
		var scrollTop = minScrollTop;

		if(originalScrollTop === null) {
			$scrollTopPageBtn.addClass('__bottom');
			originalScrollTop = $rootContainer.scrollTop();
		} else {
			$scrollTopPageBtn.removeClass('__bottom');
			scrollTop = originalScrollTop;
			originalScrollTop = null;
		}

		$rootContainer.animate({scrollTop : scrollTop}, 1, function(){
			isAnimated = false;
		});
	});

	$(document).on('mousewheel DOMMouseScroll', function(evt){
		if(!isAnimated) {
			if ($rootContainer.scrollTop() > 0) {
				$scrollTopPageBtn.removeClass('__bottom');
				originalScrollTop = null;
			}
			if ($rootContainer.scrollTop() <= 0 && !$scrollTopPageBtn.hasClass('__bottom')) {
				$scrollTopPageBtn.hide();
			}
		}
	});

	var scrollHandler = function(e)
	{
		var scrollTop = $rootContainer.scrollTop();

		if(scrollTop > maxScrollTop && scrollTop > 0) {
			$scrollTopPageBtn.show();
		} else {
			if (!$scrollTopPageBtn.hasClass('__bottom')) {
				$scrollTopPageBtn.hide();
			}
		}
	};

	scrollHandler();
	$rootContainer.scroll(scrollHandler);
});

