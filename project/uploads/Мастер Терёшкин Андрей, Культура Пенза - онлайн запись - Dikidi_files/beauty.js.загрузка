var reviews = {
	showmore: function($el) {
		var sended;
		var offset = 10;
		var limit = 10;
		var last_id = $el.data('last-id');
		
		var href = $el.data('hrefpost');
		var container = $el.data('container');
		
		if(!href) sw.alert('Отсутствует атрибут data-href');
		
		if(sended) return;
		sended = true;
		
		sw.post({
			url: href,
			loader: $('.reviews'),
			data: {
				last_id: last_id,
				limit: limit
			},
			success: function(data){
				if(data.html && container){
					$(container).append(data.html);
				}
				last_id = data.last_id;
				$el.data('last-id', data.last_id);
				
				var is_end = data.is_end;
				$el.parent().find('.count').text(data.count);
				if(is_end) $el.parent().remove();
				sended = false;
			},
			error: function(){
				sended = false;
			}
		});
	},
	disabled: function($el) {
		$(".gallery_block .gallery-container").hide();
		$("form.review_form #addimage").addClass("disabled");
	},
	save: function($reviews) {
		var firstElement = $(".reviews .reviews_list").find("li:eq(0)");
	    
		firstElement
			.css("background", "#E3F8E2")
			.css("border-radius", "5px");
			
		setTimeout(function(){
			firstElement.css("background", "#FFFFFF");			
		}, 3000)

		var countReviewsBlock = $(".reviews .reviews_count"),
			count = parseInt(countReviewsBlock.html()) + 1;
			
		countReviewsBlock.html(count);
		$(".line-info .review_count .count").html(count);
	},
	savetwo: function($reviewID, $active) {
		$("body").on("change", '.gallery-images ul', function(){
			var blockEl = $(this).closest('.gallery-container').find('.upload-box'),
				maxImg = 5,
				thisLength = $(this).find('li').length;
			if (thisLength >= maxImg) {
				blockEl.hide();
			} else {
				blockEl.show();
			}
			
			blockEl.find('span.imgCount').text(maxImg - thisLength);
		}); 
		$(".review_form .gallery-container").attr("data-review_id", $reviewID); 
		$(".review_form .gallery_block .gallery-container").removeAttr("data-stopLoad");
		$(".review_form .gallery_block").html($(".gallery_block").html()).promise().done(function(){
	        if ($active == 0) {
	        	$(".gallery-container").show();
	        }
	    });
	    
	    if ($active == 1) {
			var firstElement = $(".reviews .reviews_list").find("li:eq(0)");
		    
			firstElement
				.css("background", "#E3F8E2")
				.css("border-radius", "5px");
				
			setTimeout(function(){
				firstElement.css("background", "#FFFFFF");			
			}, 3000)
	    }
			
		$(".review_form").append('<input type="hidden" name="id" value="' + $reviewID + '">');

		var countReviewsBlock = $(".reviews .reviews_count"),
			count = parseInt(countReviewsBlock.html()) + 1;
			
		countReviewsBlock.html(count);
		$(".line-info .review_count .count").html(count);
	}
}
