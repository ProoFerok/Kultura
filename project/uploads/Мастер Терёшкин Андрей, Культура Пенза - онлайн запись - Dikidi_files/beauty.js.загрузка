		var services_filters = $('.filters.services');
		services_filters.on('input change', 'input, select', function (evt) {
			var filter_string = services_filters.find('input[name="name"]').val(),
				filter_category = services_filters.find('select[name="category"]').val();

			$('.item-services .service').each(function (i, el) {
				var $el = $(el);
				$el.removeClass('hidden');

				if (filter_category && $el.data('category') != filter_category) {
					$el.addClass('hidden');
