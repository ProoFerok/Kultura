    init_documents: function (el) {
        let $el = $(el);
        let $documents = $('.profile-wrapper-documents__document', $el);
       
        function sendMetric() {
            const category =
                new URLSearchParams(window.location.search).get('category') ||
                'documents_show_all';
            if (typeof ym !== 'function') return;
            ym(window.METRIKA_ID, 'reachGoal', 'documents-screen.open', {'source':category, 'project_id':frontend.company.id})
        }
        sendMetric();
        function filterDocuments(selectedCategory) {
            let duration = 500;

            if (selectedCategory === 'all') {
                $documents.each(function() {
                    let $this = $(this);
                    if ($this.is(':hidden')) {
                        $this.stop(true, true).fadeIn(duration);
                    }
                });
            } else {
                let documentsToShow = $documents.filter(function() {
                    return $(this).data('category') === selectedCategory;
                });

                let documentsToHide = $documents.filter(function() {
                    return $(this).data('category') !== selectedCategory;
                });

                documentsToHide.stop(true, true).fadeOut(duration);
                documentsToShow.stop(true, true).fadeIn(duration);
            }
        }

        function updateUrlCategory(category) {
            let url = new URL(window.location.href);

            if (category === 'all') {
                url.searchParams.delete('category');
            } else {
                url.searchParams.set('category', category);
            }
            window.history.pushState({ category: category }, '', url);
        }

        function getCategoryFromUrl() {
            let urlParams = new URLSearchParams(window.location.search);
            let category = urlParams.get('category');

            if (category && category !== 'all') {
                return category;
            }
            return 'all';
        }

        function syncRadioWithUrl(category) {
            if (category === 'all') {
                $('input[name=category][value="all"]', $el).prop('checked', true);
            } else {
                $(`input[name=category][value="${category}"]`, $el).prop('checked', true);
            }
        }

        let initialCategory = getCategoryFromUrl();
        syncRadioWithUrl(initialCategory);
        filterDocuments(initialCategory);

        $el.on('change', 'input[name=category]', function() {
            let newCategory = $(this).val();
            filterDocuments(newCategory);
            updateUrlCategory(newCategory);
        });
        
    }
}

