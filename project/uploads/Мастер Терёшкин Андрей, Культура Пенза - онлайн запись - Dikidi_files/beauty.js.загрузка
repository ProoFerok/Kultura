var dkd = {
	company: {
		chatMessage: function(el) {
			var $text = $('#msgText', el);
			
			$text.on('keydown', function(e) {
				if (e.keyCode === 13) {
					if (e.ctrlKey) {
						$('#msgSend', el).trigger('click');
					}
				}
			});
			
			$('#msgSend', el).on('click', function() {
				sw.ajaxAuth({
					url: sw.verifyDomain('https://chat.dikidi.ru/api/dialog/create/'),
					data: {
						company: frontend.company.id,
						concept: 'support',
						text: $text.val(),
					},
					success: function(ob) {
						var $this = $(el),
							$next = $this.next();
						
						$this.hide();
						$next.show();
						
						var link = sw.verifyDomain('https://dikidi.ru/' + frontend.lang + '/user/chat/?d=' + ob.dialog.id);
						
						$('#gotoDialog', $next).attr('href', link);
					}
				}, 'post');
			});
		},
	}
}

var complaint = {
    init: function (el) {
        if (!window?.FEATURE_FLAG?.COMPLAINT_CONTENT) {
            return;
        }
        
        this.$el = $(el);
        this.$captionReview = this.$el.find('.caption-review');
        this.$textarea = this.$el.find('.feedback-textarea');
        this.$checkboxes = this.$el.find('.be-checkbox');
        this.$submit = this.$el.find('button.submit');
        this.reason = null;

        this.updateSubmitState = () => {
            const inputLength = this.$textarea.val().trim().length;
            const shouldDisable = !this.reason || (this.reason === 'another_reason' && inputLength === 0);
            this.$submit.prop('disabled', shouldDisable);
        };

        this.$checkboxes.on('change', (event) => {
            const checkbox = event.currentTarget;
            const isChecked = checkbox.checked;

            if (isChecked) {
                this.reason = checkbox.id;
                this.updateSubmitState();
            }
        });
    },
    initTextarea: function(element) {
        const $element = $(element);
        const maxLength = parseInt(this.$textarea.attr('maxLength'));

        this.$captionReview.text(`${__('Осталось')}: ${maxLength} ${__('символов')}`);

        this.updateCaptionAndRate = () => {
            const inputLength = this.$textarea.val().length;
            this.$captionReview.text(`${__('Осталось')}: ${maxLength - inputLength} ${__('символов')}`);
            this.updateSubmitState();
        };

        $element.on('input', '.feedback-textarea', () =>  this.updateCaptionAndRate());
        this.updateCaptionAndRate();
    },
    fancyboxCustomIcon: function () {
        if (!window?.FEATURE_FLAG?.COMPLAINT_CONTENT) {
            return;
        }
        
        $(document).on('beforeShow', function() {
            const current = $.fancybox.current;
            if (!current) {
                return;
            }

            const $trigger = current.element;
            if (!$trigger) {
                return;
            }
            
            const isOurGallery = $trigger.closest(
                '.card.gallery,' +
                '.card.examples,' +
                '.profile-wrapper-reviews,' +
                '.profile-wrapper-examples,' +
                '.profile-wrapper-service,' +
                '.examples-list,' +
                '.profile-master'
            ).length > 0;
            
            if (!isOurGallery) {
                return;
            }

            const companyId = $trigger.data('company');
            const lang = $trigger.data('lang');
            const contentId = $trigger.data('content-id');
            const imageId = $trigger.data('image-id');
            const type = $trigger.data('type');

            $('.fancybox-skin .custom-btn-complaint').remove();
            
            let textComplaint = __('Пожаловаться');

            var $btn = $(`<div class="custom-btn-complaint"><span>${textComplaint}</span></div>`)
                .on('click', function(ev) {
                    ev.preventDefault();
                    ev.stopPropagation();

                    sw.ajax({
                        url: `/${frontend.lang ?? lang}/ajax/complains/show_modal`,
                        data: {
                            company: frontend?.company?.id ?? companyId,
                            type: type,
                            content_id: contentId,
                            image_id: imageId,
                        },
                        success: function () {
                            $.fancybox.close();
                        },
                        error: function () {
                            $.fancybox.close();
                        }
                    }, 'GET');
                });
            
            current.skin.append($btn);
        });

        $(document).on('afterClose', function() {
            $('.custom-btn-complaint').remove();
        });       
    },
    sendButton: function (el) {
        const $el = $(el);

        if ($el.data('event-bound')) {
            return;
        }

        $el.data('event-bound', true);
        
        const contentId = $el.data('content-id');
        const type = $el.data('type');
        const companyId = $el.data('company');
        const langData = $el.data('lang');
        const lang = frontend.lang ?? langData;
        
        $el.on('click', function () {
            if (!window?.FEATURE_FLAG?.COMPLAINT_CONTENT) {
                return;
            }
            sw.ajax({
                url: `/${lang}/ajax/complains/show_modal`,
                data: {
                    company: frontend?.company?.id ?? companyId,
                    type: type,
                    content_id: contentId,
                },
            }, 'GET')
        })
    }
}

var profile = {
	init: function (el) {

        var $el = $(el);
		var hideable = $el.find('.hideable-text.collapsed');

		hideable.each(function(i, el) {
			if (el.scrollHeight <= el.clientHeight + 2) {
				$(el).removeClass('collapsed');
			} else {
				$(el).parent().click(function(evt) {
                    metric.send('view-full-description');
					$(el).removeClass('collapsed');
				});
			}
		});

		var form = $('.filters form[data-clear]');
		var filter_timer = {};
		form.find('input[type="text"]').each(function(){
			$(this).on('textchange', function() {
				var input = this;

				window.clearTimeout(filter_timer);

				filter_timer = setTimeout(function() {
					autosubmit(input);
				}, 600);
			}).keypress(function(e) {
				if (e.which == 13) {
					e.preventDefault();
					window.clearTimeout(filter_timer);
					autosubmit(this);
				}
			});
		});

		form.find('select').on('change', function() {
			$(this).selectpicker('refresh');
			if (!$(this).attr('autosubmit')) {
				autosubmit(this);
			}
		});

		function autosubmit(el) {
			var form = $(el).closest('form');

			if (form.data('clear')) {
				$(form.data('clear')).html(null);
			}

			form.find('input[name="offset"]').val(0);
			form.trigger('submit');
		}

		// Красиво отображаем имя мастера и должность, если они по две строки
		$('.card.masters .master').each(function(i, el) {
			var $el = $(el),
				name = $el.find('.name'),
				title = $el.find('.title');

			if (name[0].scrollHeight > name[0].clientHeight + 2) {
				title.css('max-height', 17);
			}
		});

        if ($('.profile-wrapper-examples').length) {
            complaint.fancyboxCustomIcon();
        }
	},
