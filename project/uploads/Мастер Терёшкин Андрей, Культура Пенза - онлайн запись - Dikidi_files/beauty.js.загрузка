    update_review: function(e) {
        const $updateButton = $(e.currentTarget);
        const recordId = $updateButton.data('record-id');
        const loader = $updateButton.data('loader');

        sw.ajax({
            url: sw.fixDomain( window.location.origin + '/api/reviews/list?record_id=') + recordId,
            loader: loader,
        }, 'get')
            .then((answer) => {
                sw.ajax({
                    url: '/user/reviews_evaluated/change_review',
                    loader: loader,
                    data: {
                        list: answer.data.list
                    }
                }, 'post');
            });    
    },
    remove_review: function(e) {
        const $removeButton = $(e.currentTarget);
        const reviewId = $removeButton.data('review-id');

        bootbox.confirm({
            className: 'sw-dialog profile-confirm',
            message: __('Действительно хотите удалить свой отзыв?'),
            buttons: {
                confirm: {
                    label: __('Удалить'),
                    className: 'btn-primary',
                },
                cancel: {
                    label: __('Отмена'),
                    className: 'btn-secondary',
                }
            },
            callback: function(result) {
                if (result) {
                    sw.ajax({
                        url: '/' + frontend.lang + '/ajax/profile/remove_review/',
                        loader: 'body',
                        data: {id: reviewId},
                    }, 'get');
                }
            },
        });
