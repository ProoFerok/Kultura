		if (strlen > 0) {
			$('.row a', e).each(function(){
				if (!searchValuesInStr(query, $(this).html())) {
					$(this).parent().removeClass('view').addClass('hide');
				} else {
					$(this).parent().removeClass('hide').addClass('view');
				}
			});

			$('.row', e).each(function(){
				if ($('div.view', this).length > 0) {
					$(this).show();
				} else {
					$(this).hide();
				}
			});
