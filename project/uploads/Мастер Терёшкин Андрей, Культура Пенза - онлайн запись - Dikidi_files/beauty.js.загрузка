var catalog_modal_init = function(elem, limit, type, param_name) {
	var $elem = $(elem),
		$current_filters = $('#list-select-' + type + ' > li > input'),
		$current_filters_container = $('#list-select-' + type),
		$checkboxes = $elem.find('.category-checkbox');

	// подгрузка текущих фильтров
	for (var i = 0; i < $current_filters.length; i++) {
		$elem.find('#cat-filter-' + $current_filters[i].value).prop('checked', true);
	}

	$checkboxes.on('click', function () {
		var count_selected = $elem.find('.category-checkbox:checked').length;
		return count_selected <= limit;
	});

	$elem.find('.apply').on('click', function() {
		$current_filters.closest('li').remove();

		var $selected = $elem.find('.category-checkbox:checked');

		for (var i = 0; i < $selected.length; i++) {
			var $item = $($selected[i]),
				id = $item.val(),
				name = $item.data('name'),
				slug = $item.data('slug') || '',
				catalogTitle = $item.data('catalog-title') || '';

			var $li = $('<li><input type="hidden"><span class="nowrap"></span><i></i></li>');
			$li.find('input').attr('value', id).attr('name', param_name + '[]');
			$li.find('span').attr('data-slug', slug).attr('data-catalog-title', catalogTitle).text(name);
			$current_filters_container.append($li);

			$('form.catalog-form').trigger('submit');
			$elem.closest('.modal').modal('hide');
		}
	});
}

