        newElements.initSelect($('.new-elements-select.sort', $desktopForm));
        newElements.initHorizontalList($('.swiper-container', $mobileForm))

        const submitForm = function($form) {
            const url = $form.attr('action');
            const data = $form.serialize();

            sw.ajax({
                url: url,
                data: data,
                loader: 'body',
            }, 'get');
        };

        $(selectors.join(',')).on('change.reviewsFilter', function(e) {
            const $this = $(this);
            const isDesktop = $this.closest('.filters-desktop').length > 0;
            const $activeForm = isDesktop ? $desktopForm : $mobileForm;

            submitForm($activeForm);
        });
