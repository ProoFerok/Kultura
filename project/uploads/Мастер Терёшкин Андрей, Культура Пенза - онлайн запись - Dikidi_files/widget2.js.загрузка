		'  width: '+DEFAULT_WIDTH+'px;' +
		'  height: '+DEFAULT_HEIGHT+'px;' +
		'  background: rgba(255, 255, 255, 1.0); }' +
		'.'+prefix+'-modal .'+prefix+'-dialog iframe{' +
		'  border-radius: 12px;' +
		'  overflow: hidden; }' +
		'.'+prefix+'-modal .'+prefix+'-close {' +
