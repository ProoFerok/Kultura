		});
		
		function checkCountFilters() {
			let countFilters= 0;

			$element
				.find('.filters')
				.find('select, input')
				.each(function () {
					if ($(this).is('select')) {
						if ($(this).find('option[selected="selected"][value!="0"]').length) {
							countFilters++;
						}
					} else {
						if ($(this).attr('type') === 'radio' || $(this).attr('type') === 'checkbox') {
							if ($element.find(`.filters input[name="${ $(this).attr('name') }"]:checked`).length) {
								countFilters++;
