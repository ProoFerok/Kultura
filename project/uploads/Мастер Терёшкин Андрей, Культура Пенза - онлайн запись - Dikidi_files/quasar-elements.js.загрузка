							$(this).attr('type') !== 'hidden'
							&& ! $(this).attr('search-in-list')
							&& $(this).val()
						) {
							countFilters++;
						}
					}
				});
			
			if (countFilters !== 0) {
				$reset.text($reset.attr('reset-text') + ' ' + countFilters);
