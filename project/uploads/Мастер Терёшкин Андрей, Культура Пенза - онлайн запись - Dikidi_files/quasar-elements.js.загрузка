	rangePicker: function (еlement) {
		var filter = {
				'endDay': [moment().startOf('day'), moment().endOf('day')],
				'day': [moment().startOf('day'), moment().endOf('day')],
				'week': [moment().startOf('week'), moment().endOf('week')],
				'month': [moment().startOf('month'), moment().endOf('month')],
				'year': [moment().startOf('year'), moment().endOf('year')],
			},
			format = $(еlement).data('format'),
			setParams = function(start, end) {
				$('input[name="date_from"]', еlement).val(start.format(format));
				$('input[name="date_to"]', еlement).val(end.format(format));
				
				start = moment(start.format('YYYY-MM-DD'));
				end = moment(end.format('YYYY-MM-DD'));
				
				var period = get_period_from_dates(start, end),
					text = '';
				
				if ($('input[name="pre_start"]', еlement).length) {
					var prePeriod = get_period_turn(1),
						preStart = prePeriod[0],
						preEnd = prePeriod[1];
					
					$('input[name="pre_start"]', еlement).val(preStart.format(format));
					$('input[name="pre_end"]', еlement).val(preEnd.format(format));
				}
				
				prePeriodSelectChange(period);
				
				text = getTextFormat(period, start, end);
				
				$('.range', еlement).html(text);
                
                let activeButton = $('button.date-select.active', еlement);
                if(activeButton.data('value') === 'endDay') {
                    let currentDate = $(еlement).find('input[name="current_date"]').val();

                    $('input[name="date_from"]', еlement).attr('disabled', true)
                    $('button.new-elements-daterange-date-button', еlement).data('daterangepicker')
                        .setMaxDate(currentDate)
                } else {
                    $('input[name="date_from"]', еlement).removeAttr('disabled')
                    $('button.new-elements-daterange-date-button', еlement).data('daterangepicker')
                        .setMaxDate(null)
                }

				backend.autosubmit(еlement);
			},
			updateBtnTitle = function() {
				var start = moment($('input[name="date_from"]', еlement).val(), 'DD.MM.YYYY');
				var end = moment($('input[name="date_to"]', еlement).val(), 'DD.MM.YYYY');
				var period = get_period_from_dates(start, end);
				$('.range', еlement).html(getTextFormat(period, start, end));
			},
			updateFastFilter = function() {
				var start = $('input[name="date_from"]', еlement).val(),
					end = $('input[name="date_to"]', еlement).val(),
					index = 0;
				
				$('label.btn.active', еlement).removeClass('active');
				
				for (var i in filter) {
					if (start == filter[i][0].format(format) && end == filter[i][1].format(format)) {
						$('label.btn:eq('+index+')', еlement).addClass('active');
					}
					
					index++;
				}
			},
			ranges = {};
		var single = !!$(еlement).data('single');
		var lang = $(еlement).closest('html').attr('lang');
		
		moment.locale(lang);
		
		$('button.date-select[data-value]', еlement).on('click', function(e) {
            e.preventDefault();
			$(this).siblings('.active').removeClass('active');
			$(this).addClass('active');
			
			var value = $(this).data('value');
            
            let activeButton = $('button.date-select.active', еlement)
            if(activeButton.data('value') === 'now' && $('input[name="date_type"]', еlement).length > 0) {
                $('input[name="date_type"]', еlement).val(activeButton.data('value'));
            }
            
            if($(еlement).find('input[name="current_date"]').get(0)) {
                if(activeButton.data('value') === 'endDay' || activeButton.data('value') === 'day') {
                    filter[value][0] = moment($(еlement).find('input[name="current_date"]').val(), 'DD.MM.YYYY');
                    filter[value][1] = moment($(еlement).find('input[name="current_date"]').val(), 'DD.MM.YYYY');
                }
            }
			
			setParams(filter[value][0], filter[value][1]);
		});
		
		var isTime = format.indexOf('HH') >= 0;
		
		function resolve_range_title(name) {
			return name == 'day'       ? __('День')
				:  name == 'week'      ? __('Неделя')
					:  name == 'month'     ? __('Месяц')
						:/*name == 'year'*/      __('Год');
		}
		
		var prePeriodSelectChange = function(periodType) {
			if ($('select.selectpicker.btn-pre-period').length) {
				var selectPrePeriod = $('select.selectpicker.btn-pre-period'),
					start = $('input[name="date_from"]', еlement).val(),
					end = $('input[name="date_to"]', еlement).val(),
					preStart = $('input[name="pre_start"]', еlement).val(),
					preEnd = $('input[name="pre_end"]', еlement).val();
				
				start = moment(start, 'DD.MM.YYYY');
				end = moment(end, 'DD.MM.YYYY');
				preStart = moment(preStart, 'DD.MM.YYYY');
				preEnd = moment(preEnd, 'DD.MM.YYYY');
				
				if (!periodType) {
					periodType = get_period_from_dates(start, end);
				}
				
				var htmlOptions = getPrePeriodOptions(periodType, preStart, preEnd);
				
				selectPrePeriod.html(htmlOptions).selectpicker('refresh');
				
			}
		};
		
		var getTextFormat = function(period, start, end) {
			var text = '';
			
			if (period == 'day') {
				text = start.format('dd, DD MMMM');
			}
			else if (period == 'year') {
				text = start.format('MMM YYYY') + ' — ' + end.format('MMM YYYY');
			}
			else {
				text = start.format('DD MMM') + ' — ' + end.format('DD MMM');
			}
			
			return text;
		};
		
		var getPrePeriodOptions = function(periodType, preStart, preEnd) {
			var htmlReturn = '';
			
			var period = get_period_turn(1);
			var prePeriod;
			
			if (preStart && preEnd) {
				prePeriod = [preStart, preEnd]
			}
			
			if (periodType == 'day') {
				htmlReturn += get_option_template(__('Предыдущий день'), periodType, period, prePeriod);
				
				period = get_period_turn(1, 'week');
				htmlReturn += get_option_template(__('На прошлой неделе'), periodType, period, prePeriod);
			} else if (periodType == 'week') {
				htmlReturn += get_option_template(__('Предыдущие 7 дней'), periodType, period, prePeriod);
				
				period = get_period_turn(1, 'week', 4);
				htmlReturn += get_option_template(__('4 недели назад'), periodType, period, prePeriod);
				
				period = get_period_turn(1, 'year', false, 1);
				htmlReturn += get_option_template(__('В прошлом году'), periodType, period, prePeriod);
			} else if (periodType == 'month') {
				htmlReturn += get_option_template(__('Предыдущий месяц'), periodType, period, prePeriod);
				
				period = get_period_turn(1, 'year', false, 1);
				htmlReturn += get_option_template(__('В прошлом году'), periodType, period, prePeriod);
			} else if (periodType == 'year') {
				htmlReturn += get_option_template(__('Предыдущий год'), periodType, period, prePeriod);
			} else if (periodType == 'custom') {
				htmlReturn += get_option_template(__('Предыдущий период'), periodType, period, prePeriod);
			}
			
			return htmlReturn;
		};
		
		var get_option_template = function(name, periodType, period, prePeriod) {
			var $htmlReturn = '',
				selectedElement = '',
				periodFormatFrom = period[0].format(format),
				periodFormatTo = period[1].format(format);
			
			if (periodFormatFrom == prePeriod[0].format(format) && periodFormatTo == prePeriod[1].format(format)) {
				selectedElement = 'selected';
			}
			
			$htmlReturn += '<option ' + selectedElement + ' data-content="';
			$htmlReturn += '	<span class=\'btn-name-head\'>' + __('Период для сравнения') + '</span>';
			$htmlReturn += '	<span class=\'btn-name\'>' + name + '</span>';
			$htmlReturn += '	<span class=\'pre-period\'>' + getTextFormat(periodType, period[0], period[1]) + '</span>';
			$htmlReturn += '" value="' + periodFormatFrom + '_' + periodFormatTo + '"></option>';
			
			return $htmlReturn;
		}
		
		var get_period_from_dates = function(start, end) {
			var from = moment(start).startOf('day'),
				to = moment(end).endOf('day'),
				diff = to.diff(from, 'days');
			
			if(diff == 0) {
				return 'day'
			}
			else if(diff == 6 && from.isoWeekday() == 1) {
				return 'week';
			}
			else if(
				to.diff(from, 'month') == 0
				&& moment(from).startOf('month').isSame(from, 'days')
				&& moment(to).endOf('month').isSame(to, 'days')
			) {
				return 'month'
			}
			else if(
				to.diff(from, 'year') == 0
				&& moment(from).startOf('year').isSame(from, 'days')
				&& moment(to).endOf('year').isSame(to, 'days')
			) {
				return 'year'
			}
			return 'custom';
		};
		
		var get_period_turn = function(back, jumpPeriod, count, withoutOffs) {
			var start = moment($('input[name="date_from"]', еlement).val(), 'DD.MM.YYYY'),
				end = moment($('input[name="date_to"]', еlement).val(), 'DD.MM.YYYY'),
				diff = end.diff(start, 'days') + 1,
				sign = (back ? -1 : 1),
				period = get_period_from_dates(start.format('YYYY-MM-DD'), end.format('YYYY-MM-DD'));
			
			if (jumpPeriod) {
				period = jumpPeriod;
			}
			
			if (count) {
				sign = sign * count;
			}
			
			switch(period) {
				case 'day':
					start.add(sign, 'd');
					end.add(sign, 'd');
					break;
				case 'week':
					start.add(sign, 'w');
					end.add(sign, 'w');
					break;
				case 'month':
					start.add(sign, 'M');
					end.add(sign, 'M');
					if (!withoutOffs) {
						start.startOf('month');
						end.endOf('month');
					}
					break;
				case 'year':
					start.add('years', sign);
					end.add('years', sign);
					if (!withoutOffs) {
						start.startOf('year');
						end.endOf('year');
					}
					break;
				case 'custom':
				default :
					start.add(diff * sign, 'd');
					end.add(diff * sign, 'd');
					break;
			}
			
			return [start, end];
		};
		
		$('a.new-elements-calendar-prev', еlement).on('click', function() {
			var value = get_period_turn(1);
			
			setParams(value[0], value[1]);
			updateFastFilter();
		});
		
		$('a.new-elements-calendar-next', еlement).on('click', function() {
			var value = get_period_turn();
            
            let currentDate = $(еlement).find('input[name="current_date"]').val();
            if(value[1].format('DD.MM.YYYY') > currentDate) {
                let activeElement = $('button.date-select.active', еlement).data('value');
                if(activeElement === 'endDay') {
                    return;
                }
            }
			
			setParams(value[0], value[1]);
			updateFastFilter();
		});
		
		$.each(filter, function(k, r) {
			ranges[resolve_range_title(k)] = r;
		});
        
        let activeButton = $('button.date-select.active', еlement);
        maxDate = false;
        if(activeButton.data('value') === 'endDay') {
            maxDate = $(еlement).find('input[name="current_date"]').val();
            $('input[name="date_from"]', еlement).val(maxDate)
            $('input[name="date_to"]', еlement).val(maxDate)
        }

		$('button.new-elements-daterange-date-button', еlement).daterangepicker({
			locale: {
				format: format,
				firstDay: backend.user.first_day
			},
			parentEl: '.crisper',
			startDate: $('input[name="date_from"]', еlement).val(),
			endDate: $('input[name="date_to"]', еlement).val(),
            maxDate: maxDate,
			autoUpdateInput: false,
			opens: 'center',
			singleDatePicker: single,
			timePicker: isTime,
			timePicker24Hour: isTime,
			ranges: ranges
		}, function(start, end, label) {
			setParams(start, end);
			updateFastFilter();
		});
		
		updateFastFilter();
		prePeriodSelectChange();
		updateBtnTitle();
	},
    initExpandTextButton: function (element) {
        const $element = $(element);
        
        $element.on('click', '.new-elements-expand > .item', function (e) {
            e.preventDefault();
            
            $element.find('.new-elements-expand > .item').removeClass('active');
            $(this).addClass('active');
        });
    },
    initHorizontalList: function (element) {
        const $element = $(element);
        const randomId = newElements.utils.randomString(10);
        
        $element.addClass(randomId);
        
        new Swiper(`.${randomId}.swiper-container`, {
            direction: 'horizontal',
            slidesPerView: 'auto',
            freeMode: {
                enabled: true,
                sticky: false,
            },
            spaceBetween: 10,
            scrollbar: {
                el: `.${randomId} .swiper-scrollbar`,
                draggable: true,
                hide: true,
            },
            mousewheel: {
                sensitivity: 1,
            },
            keyboard: {
                enabled: true,
                onlyInViewport: true,
            },
        })
    },
    rangePickerSelect: function (еlement) {
        var filter = {
                'day': [moment().startOf('day'), moment().endOf('day')],
                'week': [moment().startOf('week'), moment().endOf('week')],
                'month': [moment().startOf('month'), moment().endOf('month')],
                'year': [moment().startOf('year'), moment().endOf('year')],
            },
            format = $(еlement).data('format'),
            setParams = function(start, end) {
                $('input[name="date_from"]', еlement).val(start.format(format));
                $('input[name="date_to"]', еlement).val(end.format(format));

                start = moment(start.format('YYYY-MM-DD'));
                end = moment(end.format('YYYY-MM-DD'));

                var period = get_period_from_dates(start, end),
                    text = '';

                if ($('input[name="pre_start"]', еlement).length) {
                    var prePeriod = get_period_turn(1),
                        preStart = prePeriod[0],
                        preEnd = prePeriod[1];

                    $('input[name="pre_start"]', еlement).val(preStart.format(format));
                    $('input[name="pre_end"]', еlement).val(preEnd.format(format));
                }

                prePeriodSelectChange(period);

                text = getTextFormat(period, start, end);

                $('.range', еlement).html(text);

                backend.autosubmit(еlement);
            },
            updateBtnTitle = function() {
                var start = moment($('input[name="date_from"]', еlement).val(), 'DD.MM.YYYY');
                var end = moment($('input[name="date_to"]', еlement).val(), 'DD.MM.YYYY');
                var period = get_period_from_dates(start, end);
                $('.range', еlement).html(getTextFormat(period, start, end));
            },
            updateFastFilter = function() {
                var start = $('input[name="date_from"]', еlement).val(),
                    end = $('input[name="date_to"]', еlement).val();

                $('select[name="period"] option', еlement).each(function() {
                    var value = $(this).val();
                    if (start == filter[value][0].format(format) && end == filter[value][1].format(format)) {
                        $(this).prop('selected', true);
                    } else {
                        $(this).prop('selected', false);
                    }
                });
            };
        ranges = {};
        var single = !!$(еlement).data('single');
        var lang = $(еlement).closest('html').attr('lang');

        moment.locale(lang);

        $('select[name="period"]', еlement).on('change', function() {
            var value = $(this).val(); // Получаем выбранный период
            setParams(filter[value][0], filter[value][1]); // Применяем новые даты
        });

        var isTime = format.indexOf('HH') >= 0;

        function resolve_range_title(name) {
            return name == 'day'       ? __('День')
                :  name == 'week'      ? __('Неделя')
                    :  name == 'month'     ? __('Месяц')
                        :/*name == 'year'*/      __('Год');
        }

        var prePeriodSelectChange = function(periodType) {
            if ($('select.selectpicker.btn-pre-period').length) {
                var selectPrePeriod = $('select.selectpicker.btn-pre-period'),
                    start = $('input[name="date_from"]', еlement).val(),
                    end = $('input[name="date_to"]', еlement).val(),
                    preStart = $('input[name="pre_start"]', еlement).val(),
                    preEnd = $('input[name="pre_end"]', еlement).val();

                start = moment(start, 'DD.MM.YYYY');
                end = moment(end, 'DD.MM.YYYY');
                preStart = moment(preStart, 'DD.MM.YYYY');
                preEnd = moment(preEnd, 'DD.MM.YYYY');

                if (!periodType) {
                    periodType = get_period_from_dates(start, end);
                }

                var htmlOptions = getPrePeriodOptions(periodType, preStart, preEnd);

                selectPrePeriod.html(htmlOptions).selectpicker('refresh');

            }
        };

        var getTextFormat = function(period, start, end) {
            var text = '';

            if (period == 'day') {
                text = start.format('dd, DD MMMM');
            }
            else if (period == 'week') {
                text = start.format('D') + ' – ' + end.format('D MMM');
            }
            else if (period == 'month') {
                text = start.format('D') + ' – ' + end.format('D MMM');
            }
            else if (period == 'year') {
                text = 'янв. – дек. ' + start.format('YYYY');
            }
            else {
                text = start.format('DD MMM') + ' — ' + end.format('DD MMM');
            }

            return text;
        };


        var getPrePeriodOptions = function(periodType, preStart, preEnd) {
            var htmlReturn = '';

            var period = get_period_turn(1);
            var prePeriod;

            if (preStart && preEnd) {
                prePeriod = [preStart, preEnd]
            }

            if (periodType == 'day') {
                htmlReturn += get_option_template(__('Предыдущий день'), periodType, period, prePeriod);

                period = get_period_turn(1, 'week');
                htmlReturn += get_option_template(__('На прошлой неделе'), periodType, period, prePeriod);
            } else if (periodType == 'week') {
                htmlReturn += get_option_template(__('Предыдущие 7 дней'), periodType, period, prePeriod);

                period = get_period_turn(1, 'week', 4);
                htmlReturn += get_option_template(__('4 недели назад'), periodType, period, prePeriod);

                period = get_period_turn(1, 'year', false, 1);
                htmlReturn += get_option_template(__('В прошлом году'), periodType, period, prePeriod);
            } else if (periodType == 'month') {
                htmlReturn += get_option_template(__('Предыдущий месяц'), periodType, period, prePeriod);

                period = get_period_turn(1, 'year', false, 1);
                htmlReturn += get_option_template(__('В прошлом году'), periodType, period, prePeriod);
            } else if (periodType == 'year') {
                htmlReturn += get_option_template(__('Предыдущий год'), periodType, period, prePeriod);
            } else if (periodType == 'custom') {
                htmlReturn += get_option_template(__('Предыдущий период'), periodType, period, prePeriod);
            }

            return htmlReturn;
        };

        var get_option_template = function(name, periodType, period, prePeriod) {
            var $htmlReturn = '',
                selectedElement = '',
                periodFormatFrom = period[0].format(format),
                periodFormatTo = period[1].format(format);

            if (periodFormatFrom == prePeriod[0].format(format) && periodFormatTo == prePeriod[1].format(format)) {
                selectedElement = 'selected';
            }

            $htmlReturn += '<option ' + selectedElement + ' data-content="';
            $htmlReturn += '	<span class=\'btn-name-head\'>' + __('Период для сравнения') + '</span>';
            $htmlReturn += '	<span class=\'btn-name\'>' + name + '</span>';
            $htmlReturn += '	<span class=\'pre-period\'>' + getTextFormat(periodType, period[0], period[1]) + '</span>';
            $htmlReturn += '" value="' + periodFormatFrom + '_' + periodFormatTo + '"></option>';

            return $htmlReturn;
        }

        var get_period_from_dates = function(start, end) {
            var from = moment(start).startOf('day'),
                to = moment(end).endOf('day'),
                diff = to.diff(from, 'days');

            if(diff == 0) {
                return 'day'
            }
            else if(diff == 6 && from.isoWeekday() == 1) {
                return 'week';
            }
            else if(
                to.diff(from, 'month') == 0
                && moment(from).startOf('month').isSame(from, 'days')
                && moment(to).endOf('month').isSame(to, 'days')
            ) {
                return 'month'
            }
            else if(
                to.diff(from, 'year') == 0
                && moment(from).startOf('year').isSame(from, 'days')
                && moment(to).endOf('year').isSame(to, 'days')
            ) {
                return 'year'
            }
            return 'custom';
        };

        var get_period_turn = function(back, jumpPeriod, count, withoutOffs) {
            var start = moment($('input[name="date_from"]', еlement).val(), 'DD.MM.YYYY'),
                end = moment($('input[name="date_to"]', еlement).val(), 'DD.MM.YYYY'),
                diff = end.diff(start, 'days') + 1,
                sign = (back ? -1 : 1),
                period = get_period_from_dates(start.format('YYYY-MM-DD'), end.format('YYYY-MM-DD'));

            if (jumpPeriod) {
                period = jumpPeriod;
            }

            if (count) {
                sign = sign * count;
            }

            switch(period) {
                case 'day':
                    start.add(sign, 'd');
                    end.add(sign, 'd');
                    break;
                case 'week':
                    start.add(sign, 'w');
                    end.add(sign, 'w');
                    break;
                case 'month':
                    start.add(sign, 'M');
                    end.add(sign, 'M');
                    if (!withoutOffs) {
                        start.startOf('month');
                        end.endOf('month');
                    }
                    break;
                case 'year':
                    start.add('years', sign);
                    end.add('years', sign);
                    if (!withoutOffs) {
                        start.startOf('year');
                        end.endOf('year');
                    }
                    break;
                case 'custom':
                default :
                    start.add(diff * sign, 'd');
                    end.add(diff * sign, 'd');
                    break;
            }

            return [start, end];
        };

        $('a.new-elements-calendar-prev', еlement).on('click', function() {
            var value = get_period_turn(1);

            setParams(value[0], value[1]);
            updateFastFilter();
        });

        $('a.new-elements-calendar-next', еlement).on('click', function() {
            var value = get_period_turn();

            setParams(value[0], value[1]);
            updateFastFilter();
        });

        $.each(filter, function(k, r) {
            ranges[resolve_range_title(k)] = r;
        });

        $('button.new-elements-daterange-date-button', еlement).daterangepicker({
            locale: {
                format: format,
                firstDay: backend.user.first_day
            },
            parentEl: '.crisper',
            startDate: $('input[name="date_from"]', еlement).val(),
            endDate: $('input[name="date_to"]', еlement).val(),
            autoUpdateInput: false,
            opens: 'center',
            singleDatePicker: single,
            timePicker: isTime,
            timePicker24Hour: isTime,
            ranges: ranges
        }, function(start, end, label) {
            setParams(start, end);
            updateFastFilter();
        });

        updateFastFilter();
        prePeriodSelectChange();
        updateBtnTitle();
    },

};
