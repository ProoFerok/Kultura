$(document).ready(function () {

	// region Выпадающий список

	$(document).on('click', function (e) {
		if (
			!$(e.target).is($(document).find('.new-elements-expand-clicked'))
			&& !$(e.target).is($(document).find('.new-elements-expand'))
		) {
			closeExpands();
		}
	});
	
	function closeExpands() {
		$(document).find('.new-elements-expand.open').removeClass('open');
		$(document).find('.new-elements-expand-btn.open').removeClass('open');
	}
	
	$(document).on('click', '.new-elements-expand-clicked', function (e) {
		e.stopPropagation();

		if (
			$(this).next().hasClass('new-elements-expand')
			&& !$(this).next().hasClass('open')
		) {
			closeExpands();

			$(this).next().addClass('open');
		} else {
			closeExpands();
		}
	});
	
	// endregion
});

const newElements= {
	data: {
		ruleSetWithParams: [
			'length',
			'percent',
            'promocode'
		],
		ruleSetWithoutParams: [
			'empty',
			'digits',
            'notZero'
		],
		validateTextByRules: {
			empty: __('Поле не должно быть пустым'),
			digits: __('Поле должно состоять только из цифр'),
			length: __('Поле не должно быть длиннее :param символов'),
			percent: __('Процент должен быть в диапазоне от 0 до :param'),
            promocode: __('Промокод не должен содержать символы :param'),
            notZero: __('Поле не должно быть пустым и не должно быть нулем')
		},
	},
	utils: {
		prepareRules: function (rulesString) {
			const rules = rulesString.split(',').map(n => n.trim());
			
			if (!rules.length) {
				throw new Error(__('Строка с правилами валидации пуста'));
			}
			
			const preparedRules = [];
			
			for (const rule of rules) {
				let rulePair = [];
				
				for (const r of newElements.data.ruleSetWithParams) {
					if (!rule.startsWith(r)) {
						continue;
					}
					
					if (rule.split(':').length === 1) {
						throw new Error(__('Неверный формат правила валидации'));
					}
					
					rulePair = rule.split(':');
					
					if (rulePair.length === 2) {
						rulePair[1] = parseInt(rulePair[1]);

						if (isNaN(rulePair[1])) {
							throw new Error(__('Неверный формат правила валидации'));
						}
					}
				}
				
				for (const r of newElements.data.ruleSetWithoutParams) {
					if (r !== rule) {
						continue;
					}
					
					rulePair.push(rule);
				}
				
				if (
					!rulePair.length
					|| (
						newElements.data.ruleSetWithParams.indexOf(rulePair[0]) === -1
						&& newElements.data.ruleSetWithoutParams.indexOf(rulePair[0]) === -1
					)
				) {
					throw new Error(__('Неизвестное правило валидации'));
				}
				
				preparedRules.push(rulePair);
			}
			
			return preparedRules;
		},
		getErrorTextByRule: function (rule, params) {
			if (!newElements.data.validateTextByRules[rule]) {
				throw new Error(__('Не указаны типы валидации для правила :rule', { ':rule': rule }));
			}
			
			let text = newElements.data.validateTextByRules[rule];
			
			if (params) {
				text = text.replace(':param', params);
			}
			
			return text;
		},
		validate: function ($control, ruleSet) {
			const _this = newElements;
			const rules = newElements.utils.prepareRules(ruleSet);
			const errors = [];
			
			for (const rs of rules) {
				const rule = rs[0];
				
				switch (rule) {
					case 'empty':
						if ($control.is('input')) {
							if ($control.data('datepicker')) {
								if (!$control.data('original-date')) {
									errors.push({
										rule: rule,
										text: _this.utils.getErrorTextByRule(rule),
									});
								}
							} else {
								if (!$control.val().trim()) {
									errors.push({
										rule: rule,
										text: _this.utils.getErrorTextByRule(rule),
									});
								}
							}
						}
						
						if ($control.is('textarea')) {
							if (!$control.val().trim()) {
								errors.push({
									rule: rule,
									text: _this.utils.getErrorTextByRule(rule),
								});
							}
						}

						if ($control.is('select')) {
							if (!$control.find('option[selected="selected"]').length) {
								errors.push({
									rule: rule,
									text: _this.utils.getErrorTextByRule(rule),
								});
							}
						}
						
						break;
						
					case 'percent':
						if ($control.is('input')) {
							const percentCount = rs[1];
							
							if (!(new RegExp(`^(\\d{1,2}|${ percentCount })$`)).test($control.val())) {
								errors.push({
									rule: rule,
									text: _this.utils.getErrorTextByRule(rule, percentCount),
								});
							}
						}
						
						break;

					case 'length':
						if ($control.is('input')) {
							if ($control.val().length > rs[1]) {
								errors.push({
									rule: rule,
									text: _this.utils.getErrorTextByRule(rule, rs[1]),
								});
							}
						}
						
						break;
						
					case 'digits':
						if ($control.is('input')) {
							if (!$control.val().trim().match(/^\d+$/) && $control.val().trim().length > 0) {
								errors.push({
									rule: rule,
									text: _this.utils.getErrorTextByRule(rule),
								});
							}
						}
						
						break;
                        
                    case 'promocode':
                        if ($control.is('input')) {
                            const ruleArray = rs.splice(1)
                            const comparisonArray = array_diff(ruleArray, $control.val().split(""))
                            if (ruleArray.length !== comparisonArray.length) {
                                errors.push({
                                    rule: rule,
                                    text: _this.utils.getErrorTextByRule(rule, ruleArray),
                                });
                            }
                        }
                        
                        break;
                        
                    case 'notZero':
                        if ($control.is('input')) {
                            if ($control.val() === '' || $control.val() === '0') {
                                errors.push({
                                    rule: rule,
                                    text: _this.utils.getErrorTextByRule(rule),
                                });
                            }
                        }
				}	
			}
			
			return errors;
		},
		createErrorContentBlock: function (errorText, align) {
			return $(`
				<div class="new-elements-content-block error ${ align }">
					<div class="warning-icon"></div>
					<div class="error-text">${ errorText }</div>
				</div>
			`);
		},
		executeValidate: function ($control, parentElementSelector) {
			const _this = newElements;
			
			if (!parentElementSelector) {
				throw new Error(__('Не указан селектор родительского элемента'));
			}
			
			if (!$control.is('[validatable]')) {
				throw new Error(__('Вызов события валидации на невалидированном элементе'));
			}

			const validateRule = $control.attr('validate-rule');

			if (!validateRule) {
				throw new Error(__('Не указаны типы валидации'));
			}
            
            // Если элемент скрыт, то пропускаем
            if($control.is(":hidden")) {
               return;
            }

            const validationErrors = _this.utils.validate($control, validateRule);
			
			if (!validationErrors.length) {
				return;
			}

			$control.attr('validate-error', true);

			let align = $control.attr('validate-align');

			if (!align) {
				align = 'left';
			}
			
			let validateText = validationErrors[0]['text'];
			
			if ($control.attr('validate-text')) {
				validateText = $control.attr('validate-text');
			}
			
			const $parent = $control.closest(parentElementSelector);

			$parent.find('.error').remove();
			$parent.append(_this.utils.createErrorContentBlock(validateText, align));
		},
		executeValidateContentBlock: function ($block) {
			$block.attr('validate-error', true);

			const validateText = $block.attr('validate-text');
			let align = $block.attr('validate-align');

			if (!validateText) {
				throw new Error(__('Не указан текст валидации у элемента'));
			}

			if (!align) {
				align = 'left';
			}
			
			$block.find('.error').remove();
			$block.append(newElements.utils.createErrorContentBlock(validateText, align));
		},
		assertArray: function (a, b) {
			a = a.sort();
			b = b.sort();

			if (a.length !== b.length) {
				return false;
			}

			for (let i = 0; i < a.length; i++) {
				if (a[i] !== b[i]) {
					return false;
				}
			}

			return true;
		},
        randomString: function (length) {
            let result = '';
            const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
            const charactersLength = characters.length;
            let counter = 0;
            
            while (counter < length) {
                result += characters.charAt(Math.floor(Math.random() * charactersLength));
                counter += 1;
            }
            
            return result;
        }, 
	},
	initSelect: function (element) {
		const $element = $(element);
		const $select = $element.find('select');
		
        // Отрисовывает селект
		$element.on('refresh', 'select', function () {
			$element.find('.button').remove();
			$element.find('.list').remove();
			
			$element.append(`
				<div class="button">
					<div class="placeholder"></div>
					<div class="text"></div>
				</div>
				<div class="list">
					<div class="elements"></div>
				</div>
			`);
			
			const $button = $element.closest('.new-elements-select').find('.button');
			const $list = $element.find('.list');
			const $placeholder = $element.find('.placeholder');
			const placeholder = $(this).attr('placeholder') && $(this).attr('placeholder').length 
				? $(this).attr('placeholder')
				: __('Выберите элемент');
			const $options = $select.find('option');
			const $selectedOptions = $select.find('option[selected]');
			const withLiveSearch = $(this).is('[live-search]');
			const withQuickButtons = $(this).is('[quick-buttons]');
            const liveSearchPlaceholder = $(this).attr('live-search-placeholder') && $(this).attr('live-search-placeholder').length
                ? $(this).attr('live-search-placeholder')
                : __('Поиск по названию')

			$placeholder.text(placeholder);
			
			$list.find('.elements').empty();
			
			if (withQuickButtons && $select.attr('multiple')) {
				$list.prepend(`
					<div class="new-elements-combined-buttons">
						<button class="select">${ __('Выбрать все') }</button>
						<button class="remove">${ __('Снять выделения') }</button>
					</div>
				`);
			}
			
			if (withLiveSearch) {
				$list.prepend(`<input search-in-list autosubmit="false" type="text" class="search-field" placeholder="${ liveSearchPlaceholder }">`);
			}
			
			let wasOneSelected = false;
			
			$options.each(function () {
				const selected = $(this).attr('selected');
				
				const $option = `
					<div 
						class="option ${ selected ? 'active' : '' }" 
						data-value="${ $(this).val() }"
						data-text="${ $(this).html().toLowerCase() }"
					>
						${ $(this).html() }
					</div>
				`;
				
				$list
					.find('.elements')
					.append($option);

				if (selected) {
					$(this).prop('selected', true);

					wasOneSelected = true;
				}
			});
			
			if ($select.attr('multiple')) {
				const showCount = $select.attr('show-count') || 4;

				if ($selectedOptions.length > showCount) {
					$button.find('.text').text($selectedOptions.length + ' ' + __('из') + ' ' + $options.length + ' ' + __('выбрано'));
				} else {
					const selectedNames = [];
					
					$selectedOptions.each(function () {
						selectedNames.push($(this).text().trim());
					});
					
					$button.find('.text').text(selectedNames.join(', '));
				}
			} else {
				$button.find('.text').text($selectedOptions.eq(0).text().trim());
			}

			if (!$selectedOptions.length) {
				$button.find('.text').text('');
			} else {
				$button.addClass('active');
			}
			
			if (wasOneSelected) {
				$select.trigger('change');
			}
		});
		
        // Полностью чистит селект
		$element.on('clear', 'select', function (e, data) {
			$(this).trigger('reset', {withoutChange: data.withoutChange});
			$(this).empty();
			
			$element.find('.list .elements').empty();
		});
		
        // Сбрасывает выбранные элементы селекта
		$element.on('selected-reset', 'select', function (e, data) {
			$element.find('.button > .text').empty();
			
			$(this).find('option[selected="selected"]').each(function () {
				$(this).attr('selected', false);
				$(this).prop('selected', false);
			});
			
			$element.find('.list > .elements > .option.active').removeClass('active');
			
			if (!data || !data.withoutChange) {
				$(this).trigger('change');	
			}
		});
        
        // Сбрасывает выбранные элементы селекта и сбрасывает состояние
		$element.on('reset', 'select', function (e, data) {
			$(this).trigger('selected-reset', { withoutChange: data.withoutChange });
			
			$element.find('.button').removeClass('active');
			$element.find('.button').removeClass('with-border');
			$element.find('.list').removeClass('active');
		});
		
		$element.on('list-item-click', '.list > .elements > .option', function (e, data) {
			const $selectOption = data.option;
			const $buttonText = $element.find('.button > .text');
			
			if ($selectOption.attr('selected')) {
				$selectOption.attr('selected', false);
				$selectOption.prop('selected', false);
				
				$(this).removeClass('active');
			} else {
				$selectOption.attr('selected', true);
				$selectOption.prop('selected', true);
				
				$(this).addClass('active');
			}
			
			const $options = $select.find('option');
			const $selectedOptions = $select.find('option[selected="selected"]');
			const selectedOption = [];
			
			$selectedOptions.each(function () {
				selectedOption.push($(this).text().trim());
			});
			
			const showCount = $select.attr('show-count') || 4;
			
			if ($selectedOptions.length > showCount) {
				$buttonText.text($selectedOptions.length + ' ' + __('из') + ' ' + $options.length + ' ' + __('выбрано'));
			} else {
				$buttonText.text(selectedOption.join(', '));
				
				if (!$selectedOptions.length) {
					$buttonText.text('');
				}
			}
		});
		
		$element.on('validate', 'select', function () {
			newElements.utils.executeValidate($(this), '.new-elements-select');
		});
		
        // Событие по скрытию выпадающего списка селекта
		$element.on('list-hidden', '.list', function () {
			$(this).removeClass('active');
			
			if ($(this).closest('.new-elements-select').find('select').is('[live-search]')) {
				$(this).find('input.search-field').val('');
				$(this).find('.elements .option').removeClass('hidden');
			}
		})
        
		$element.on('click', '.list > .elements > .option', function () {
			const $option = $element.find(`select > option[value=${ $(this).attr('data-value') }]`);
			
			if ($select.is('[multiple]')) {
				$(this).trigger('list-item-click', { option: $option });
			} else {
				const $options= $select.find('option');
				
				$options.prop('selected', false);
				$options.attr('selected', false);
                
				$option.prop('selected', true);
				$option.attr('selected', true);
				
				$element.find('.button > .text').text($option.text());
				
				$(this).closest('.list').removeClass('active');
				
				if (!$(this).hasClass('active')) {
					$(this).closest('.list').find('.option').removeClass('active');
					$(this).addClass('active');
				}
			}
			
			$option.trigger('change');
		});
		
        // Событие по вводу в поле поиска селекта
		$element.on('input', '.list > .search-field', function () {
			const $elements = $(this).closest('.list').find('.elements');
			let value = $(this).val().trim().toLowerCase();
			
			if (!value.length) {
				$elements.find('.option').removeClass('hidden');
				
				return;
			}
			
			value = value.replaceAll('\\', '');
			
			$elements.find('.option').addClass('hidden');
			$elements.find(`.option[data-text*="${ value }"]`).removeClass('hidden');
		});
		
		$element.on('change', 'select', function () {
			if ($(this).find('option[selected="selected"]').length && $(this).is('[validate-error]')) {
				$(this).removeAttr('validate-error');
				$(this).closest('.new-elements-select').find('.error').remove();
			}
		});
		
        // Клик по кнопкам выбора и сброса внутри
		$element.on('click', '.new-elements-combined-buttons button', function (e) {
			e.preventDefault();
            
			// Выбрать все
			if ($(this).hasClass('select')) {
                $select.trigger('selected-reset');
                
				const $options = $element.find(`.list > .elements > .option:not(.hidden)`);
				let $lastOption = null;
				
				$options.each(function () {
					const $option = $element.find(`select > option[value=${ $(this).attr('data-value') }]`);
					$lastOption = $option;
					
					$(this).trigger('list-item-click', { option: $option });
				});
				
				$lastOption.trigger('change');
			} else if ($(this).hasClass('remove')) {
                $select.trigger('selected-reset');
			}
		});
		
		$element.on('click', '.button, .button *', function () {
			if ($select.prop('disabled')) {
				return;
			}
			
			const $list = $element.find('.list');
			const $button = $element.find('.button');
			
			$button
				.addClass('active')
				.addClass('with-border');
			$list.addClass('active');
		});
		
		$(document).on('click', function (e) {
			if (
				$(e.target).is($element)
				|| $(e.target).is($element.find('*'))
			) {
				return;
			}

			if ($element.find('select').prop('disabled')) {
				return;
			}

			if ($element.find('.list').hasClass('active')) {
				$element.find('.list').trigger('list-hidden');
			}

			if ($element.find('.button').hasClass('active')) {
				const $button = $element.find('.button');

				$button.removeClass('with-border');

				if (!$element.find('select > option[selected]').length) {
					$button.removeClass('active');
				}
			}
		});
        
		$select.trigger('refresh');
	},
	initDatepicker: function (element) {
		const $element = $(element);
		
		const monthNamesShort = [
			'янв',
			'фев',
			'мар',
			'апр',
			'мая',
			'июн',
			'июл',
			'авг',
			'сен',
			'окт',
			'ноя',
			'дек'
		];
		const monthNames = [
			'января',
			'февраля',
			'марта',
			'апреля',
			'мая',
			'июня',
			'июля',
			'августа',
			'сентября',
			'октября',
			'ноября',
			'декабря'
		];
		const dayNamesShort = [
			'вс',
			'пн',
			'вт',
			'ср',
			'чт',
			'пт',
			'сб',
		];
		const dayNames = [
			'воскресенье',
			'понедельник',
			'вторник',
			'среда',
			'четверг',
			'пятница',
			'суббота',
		];
		
		const selectorsWithScrolls = [
			'.scroll-block',
		];
		
		$element.on('refresh', 'input', function () {
			const value = $(this).data('original-date');
				
			if (!value) {
				return;
			}

			$element
				.find('label')
				.addClass('focus');
			$(this)
				.addClass('focus');

			let year, month, day;
			
			[day, month, year] = value.split('.');
			
			const formattedDate = $.datepicker.formatDate(
				'D, d M',
				new Date(parseInt(year), parseInt(month) - 1, parseInt(day)),
				{
					monthNamesShort: monthNamesShort,
					monthNames: monthNames,
					dayNamesShort: dayNamesShort,
					dayNames: dayNames,
				}
			);

			$(this).val(formattedDate);
		});
		
		$element.on('focus', 'input', function () {
			const $input = $(this);

			$element
				.find('label')
				.addClass('focus');
			$input
				.addClass('focus')
				.addClass('with-border');
			
			const options = {
				firstDay: backend.user.first_day,
				autoclose:true,
				onSelect: function(dateText, inst) {
					const formattedDate = $.datepicker.formatDate(
						'D, d M',
						new Date(inst.selectedYear, inst.selectedMonth, inst.selectedDay),
						{
							monthNamesShort: monthNamesShort,
							monthNames: monthNames,
							dayNamesShort: dayNamesShort,
							dayNames: dayNames,
						}
					);

					inst.input.val(formattedDate);
					inst.input.attr('data-original-date', dateText);
					inst.input.data('original-date', dateText);

					$input.removeClass('with-border');

					$element
						.find('label')
						.addClass('focus');
					inst.input.addClass('focus');

					inst.input.trigger('change');
				},
			};
			
			if (!$input.is('[with-previous-dates]')) {
				options.minDate = new Date();
			}

            if ($input.is('[min-date]')) {
                options.minDate = new Date($input.attr('min-date'));
            }

            if ($input.is('[max-date]')) {
                options.maxDate = new Date($input.attr('max-date'));
            }
			
			$input.datepicker(options);
		});
		
		$element.on('validate', 'input', function () {
			newElements.utils.executeValidate($(this), '.new-elements-datepicker');
		});
		
		$element.on('change', 'input', function () {
			if ($(this).val() && $(this).is('[validate-error]')) {
				$(this).removeAttr('validate-error');
				$(this).closest('.new-elements-datepicker').find('.error').remove();
			}

			if (!$(this).val()) {
				$(this).removeAttr('data-original-date');
				$(this).data('original-date', null);
			}
		});

		$element.on('input', 'input', function () {
			$(this).removeAttr('data-original-date');
			$(this).data('original-date', null);
		});
		
		$element.on('reset', 'input', function () {
			$(this).data('original-date', null);
			$(this).val('');

			$element
				.find('label')
				.removeClass('focus');
			$(this)
				.removeClass('focus');
		})
		
		$(document).on('click', function (e) {
			if (
				$(e.target).is($element)
				|| $(e.target).is($element.find('*'))
			) {
