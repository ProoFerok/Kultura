    w.swAsyncPolling = function(url, data, loader = null, timeout = 3000, successFunction = null, isWarningError = false) {
        if (loader == null) {
            loader = 'body';
        }
        
        $(loader).setLoader();
        
        let stopped = false;
        
        data.asyncProcessId = null;
        
        function polling() {
            if (stopped) {
                $(loader).removeLoader();
                
                return;
            }
            
            sw.ajax({
                url: url,
                loader: '',
                data: data,
                success: function (response) {
                    if (response.redirect_link) {
                        stopped = true;
                        
                        window.location.href = response.redirect_link;
                    } else {
                        if (response.status !== 'waiting') {
                            stopped = true;

                            if (successFunction !== null) {
                                successFunction();
                            }
                        } else {
                            if (response.asyncProcessId) {
                                if (data.asyncProcessId === null) {
                                    data.asyncProcessId = response.asyncProcessId
                                }
                            }
                        }
                    }
                    
                    if (! stopped) {
                        setTimeout(polling, timeout);
                    } else {
                        $(loader).removeLoader();
                    }
                },
                error: function (response) {
                    if (isWarningError) {
                        var message = response.message;

                        bootbox.alert({
                            className: 'sw-dialog modal-alert ' + data.theme,
                            title: __('Внимание!'),
                            message: message,
                        });
                    }
                    
                    stopped = true;
                    setTimeout(polling, timeout);
                }
            }, 'post');
        }
        
