				var u = sw.fixDomain('https://auth.dikidi.ru/social/' + $(this).attr('id'));
				
                if($(this).attr('id') === 'alfa_id') {
                    window.popupAuth = window.open(u, $('body').attr('agent-mobile') ? '_self' : '_blank', 'height=680,width=1024');
