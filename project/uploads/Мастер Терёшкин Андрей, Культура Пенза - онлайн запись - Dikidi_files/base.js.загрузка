        telegramAuth: function (form) {
            const $form = $(form).parent().parent();
            const $isRedirect = $form.find('input[name="isRedirect"]').val();
            const $sessionId = $form.parent().find('input[name="sessionId"]').val();

            if((!$form.find('#agreements').get(0) && !$form.find('#not-child').get(0)) || ($form.find('#agreements').is(':checked') && $form.find('#not-child').is(':checked'))) {
                sw.ajax({
                    url: sw.fixDomain('https://auth.dikidi.ru/ajax/social/telegram_auth') + '/?sessionId='+$sessionId,
                    loader: false,
                    success: function (response) {
                        let data = response;
                        
                        if(!data.auth && data.callbackUrl) {
                            if($isRedirect == 'false') {
                                window.location.href = window.location.href
                            } else {
                                window.location.href = data.callbackUrl
                            }
                            return;
                        }
                        if(data.auth && data.callback) {
                            if($isRedirect == 'false') {
                                window.location.href = window.location.href
                            } else {
                                window.location.href = data.callback;
                            }
                            return;
                        }
                    }
                }, 'post', true)   
            }
        },
