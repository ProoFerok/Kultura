            const $form = $(form);
            const $isRedirect = $form.find('input[name="isRedirect"]').val();
            const $sessionId = $form.find('input[name="sessionId"]').val();
            const $theme = $form.find('input[name="theme"]').val();
            const $lang = $form.find('input[name="lang"]').val();
            
            $form.find('.container.base button').click();
            
            const $back = $form.find('#back');
            $back.show();
            const $container = $('.container:visible', sw.auth.bootbox);
            $container.hide()
            
            $back.on('click', function() {
                clearInterval(checkInterval)
                $('.telegram-auth').hide();
                $form.hide();
                $container.show();
            });
            
            $('.telegram-auth .bootbox-close-button.close').on('click', function() {
                clearInterval(checkInterval)
                $container.show();
            });
            
            const checkInterval = setInterval(async () => {
                const $url = $form.find('input[name="url"]').val();
 
                sw.ajax({
                    url: $url + '/?isRedirect='+$isRedirect + '&sessionId='+$sessionId + '&theme=' + $theme + '&lang=' + $lang,
                    loader: false,
                    success: function (response) {
                        if(response.dialog) {
                            clearInterval(checkInterval)
                            $('.modal.telegram-auth').hide();
                            $('.modal.auth').hide();   
                        } else if (response.callbackUrl) {
                            window.location.href = response.callbackUrl
                        }
                    }
                }, 'get');

            }, 3000);
