	form: function(e) {
		var $e = $(e), $submit = $('button[type="submit"]', $e);

		$submit.setLoader();
		
		var ob = {
			url: $e.attr('action'),
			data: $e.serialize(),
			type: $e.attr('method'),
			dataType: 'json',
			success: function(ob) {
				if ($e.hasEvent('success')) {
					if (typeof ob == 'object' && 'data' in ob) {
						ob = ob.data;
					}
					
					$e.trigger('success', ob);
				} else {
					sw.result(ob, $e);
				}
			},
			error: function(ob) {
				var er;
				
				try {
					er = ob.responseJSON.error;
				} catch (e) {
					er = {
						code: 500,
						message: __('Ошибка при выполнении запроса'),
					};
					
					console.error(e.name + ': ' + e.message);
				}
				
				if ($e.hasEvent('error')) {
					$e.trigger('error', er);
				} else {
					sw.alert(er.message);
				}
			},
			complete: function() {
				$submit.removeLoader();
			}
		};
		
		if (ob.url.indexOf('//') > 0 && ob.url.indexOf('dikidi.') > 0) {
			ob.crossDomain = true;
			ob.xhrFields = {
				withCredentials: true,
			};
		}
		
		$.ajax(ob);
		
		return false;
	},
});

(function($){
	$.fn.countdown = function(){
		this.each(function() {
			var $this = $(this),
				timer = $(this).data('seconds'),
				template = $(this).data('template') || '%m:%s',
				n = new Date().getTime();
			
			n += timer * 1000;

			if (!is_done()) {
				var x = setInterval(function() {
					var t = new Date().getTime(),
						d = n - t;

					if (is_done()) {
						clearInterval(x);
						return true;
					}

					var m = Math.floor((d % (1000 * 60 * 60)) / (1000 * 60));
					var s = Math.floor((d % (1000 * 60)) / 1000);

					if (m < 10) m = '0' + m;
					if (s < 10) s = '0' + s;

