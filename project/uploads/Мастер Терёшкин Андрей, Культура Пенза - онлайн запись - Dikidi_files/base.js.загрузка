		getPow: function(source) {
			var parts = (source||'').split(':');
			var pow = {head:parts[0], tail:parts[1], hash:parts[2], time:parts[3], sign:parts[4]};
			var index = 0;
			var token;
			while (true) {
				index++;
				if(md5('' + pow.head + index + pow.tail) === pow.hash) {
					token = [index, pow.head, pow.tail, pow.hash, pow.time, pow.sign].join(':');
					break;
				}
				if(index > 1000000) break;
			}
			return token;
		},
		checkStatusTimer: null,
		checkStatus: function(session) {
			if(sw.sms.checkStatusTimer)
				clearTimeout(sw.sms.checkStatusTimer);
			var counter = 1;
			var check = function() {
				sw.sms.checkStatusTimer = setTimeout(function() {
					var timer = sw.sms.checkStatusTimer;
					sw.ajax({
						url: sw.fixDomain('https://sms.dikidi.ru/api/sms/check/?session='+session),
						loader: false
					}, 'get', true).done(function(data) {
						if(timer !== sw.sms.checkStatusTimer) return;
						if(data && data.data && data.data.success == 1) return;
						counter++;
						if(counter <= 10)
							check();
					});
				}, 3000);
			};
			check();
		}
	},
