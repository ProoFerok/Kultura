					data: {
						callback: sw.fixDomain('https://auth.dikidi.ru/ajax/user/forgot/'),
						number: $('#number', sw.auth.form).val(),
						type: 'recovery',
						csrf: $('[name=csrf]', sw.auth.form).val()
					},
				}, 'post', true);
			});
			
			window.addEventListener('message', function(event) {
				if (typeof event.data == 'object') {
					if ('_ym' in event.data) {return;} // Авторизация через яндекс ID
					window.popupAuth.close();
					
					if ('token' in event.data) {
						window.location.reload();
					} else if ('error' in event.data) {
						sw.alert(event.data.error);
					} else if ('code' in event.data) {
						sw.ajax({
							url: sw.fixDomain('https://auth.dikidi.ru/ajax/social/activation/'),
							loader: false,
							data: {
								code: event.data.code,
							},
							success: function(ob) {
								sw.auth.bootbox.trigger('container', 'dynamic');
							}
						}, 'get', true);
					}
				}
			}, false);
            
            // Резервный вариант закрытия, так как facebook теряет window.opener
            var bc = new BroadcastChannel('auth');
            bc.addEventListener('message', function (event) {
                if (typeof event.data == 'object') {
                    window.postMessage(event.data, '*');
                }
            });
		},
