                }
			});
			
			$('#number', sw.auth.form).on('textchange', function() {
				var $pocket = $('.pocket', sw.auth.form);
				
				if ($('> div', $pocket).length != 0) {
					sw.auth.form.attr('action', sw.fixDomain('https://auth.dikidi.ru/ajax/check/auth/'));
					$pocket.html('');
				}
				
				if (this.value.length == this.getAttribute('data-maxlength')) {
					if (this.getAttribute('code') == '7' && (this.value.substring(0, 2) == '77' || this.value.substring(0, 2) == '78')) {
						return;
					}
					sw.auth.form.submit();
				}
			});

