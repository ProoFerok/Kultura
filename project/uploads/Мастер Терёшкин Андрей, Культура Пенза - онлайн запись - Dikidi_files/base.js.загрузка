		check_validation: function (phone) {
			sw.ajax({
				url: sw.fixDomain('https://auth.dikidi.ru/ajax/user/check_mobile_id'),
				data: {
					phone: phone,
				},
				loader: null,
				success: function (data) {
					var action = $('div.verification[data-type]').data('type');
					if (data.validated > 0) {
						if (action == 'recovery') {
							// Восстановление пароля
							sw.ajax({
								url: sw.fixDomain('https://auth.dikidi.ru/ajax/user/forgot/'),
								loader: false,
								data: {
									number: phone,
								},
							}, 'post', true);
						}
						if (action == 'registration') {
							// регистрация
							var r_form = $('div.registration');
							sw.ajax({
								url: sw.fixDomain('https://auth.dikidi.ru/ajax/user/create/'),
								loader: false,
								data: {
									number: phone,
									name: r_form.find('input[name="name"]').val(),
									email: r_form.find('input[name="email"]').val(),
									password: r_form.find('input[name="password"]').val(),
									csrf: r_form.find('input[name="csrf"]').val(),
								},
							}, 'post', true);
						}
						if (action == 'social-link') {
							// проверка номера после соцсетей
							var v_container = $('div.verification-container');
							var url = v_container.find('form').attr('action');
							sw.ajax({
								url: sw.fixDomain(url),
								loader: false,
								data: {
									number: phone,
									csrf: v_container.find('input[name="csrf"]').val(),
								},
							}, 'post', true);
						}
						return;
					}
					if (data.failed > 0) {
						var container = $('div.verification-container'),
							sms_form = container.find('> form'),
							sms_title = sms_form.find('div.help-block'),
							mobile_id_form = container.find('> .mobile_id ');
						
						sms_form.removeClass('hidden');
						mobile_id_form.addClass('hidden');
						
						sms_title.text(__("Произошла ошибка подтверждения через Mobile ID, попробуйте подтвердить другим способом"));
						$('#resend-code').trigger('click');
						return;
					}
					setTimeout(function() {sw.auth.check_validation(phone)}, 2000);
				},
				fail: function () {
					setTimeout(function() {sw.auth.check_validation(phone)}, 2000);
				},
			}, 'POST');
		},
		complete: function(token) {
			if (sw.isInIframe() && token) {
				var get = window.location.href.indexOf('?') > 0 ? '&' : '?';
				window.location.href = (window.location.href + get + 'token=' + token).replace('#', '');
			} else {
				window.location.reload();
			}
		},
