				ctrlDown = false;

			var checkPattern = function(pattern, value) {
				pattern = new RegExp(pattern);

				return pattern.test(value);
			}

			$tel.on('keydown', function(e) {
				var key = e.keyCode;

				if (!ctrlDown && in_array(key, [17, 91])) {
					ctrlDown = true;
				}

				if (ctrlDown) {
					return true;
				}

				var pattern = e.target.getAttribute('pattern'),
					char = String.fromCharCode((96 <= key && key <= 105)? key-48 : key);

				if (in_array(key, [8,9,13,35,36,37,39,46]) && checkPattern(pattern, this.value)) {
					return true;
				}
				
				return checkPattern(pattern, this.value + char);
			}).on('keyup', function(e) {
				if (ctrlDown && in_array(e.keyCode, [17, 91])) {
					ctrlDown = false;
				}
				
				var code = e.target.getAttribute('code'),
					pattern = e.target.getAttribute('pattern'),
					maxLength = e.target.getAttribute('data-maxlength');
				
				// Сначала попытаемся отбросить все не цифры
				if (!checkPattern(pattern, this.value)) {
					this.value = this.value.replaceAll(/\D/g, '');
				}

				// Частный случай для России - оставляем только 7
				// если в начале номера 77 или 78 И длина номера на 1 больше максимальной длины
				// (ошибка при вставке номера произошла)
				if (this.value.length - 1 == maxLength
					&& code == '7'
					&& (this.value.substring(0, 2) == '77' || this.value.substring(0, 2) == '78')) {
					this.value = code + this.value.substring(2, this.value.length);
				}
				
				// Если прошлые шаги не помогли - тогда выкидываем всё.
				if (!checkPattern(pattern, this.value)) {
					this.value = code;
				}
				
				// отрезаем лишнее
				var maxLength = this.getAttribute('data-maxlength');
				if (maxLength && this.value.length > maxLength) {
					this.value = this.value.substring(0, maxLength);
				}
			});

			var setFlag = function (e) {
				var $a = $(e),
					pattern = $a.data('pattern');

				if (!checkPattern(pattern, $tel.val())) {
