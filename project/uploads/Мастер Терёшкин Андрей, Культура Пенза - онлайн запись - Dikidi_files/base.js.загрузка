				}

				$tel.attr('data-maxlength', $a.data('limit'))
					.attr('minlength', $a.data('min'))
					.attr('code', $a.data('code'))
					.attr('pattern', pattern)
					.focus();

				$('.input-group-btn .btn .flag', $box).attr('class', 'flag ' + $a.data('flag'));
			}

			$('li > a', $box).on('click', function() {
				setFlag(this);
			});

			var $used = $('a[data-flag="' + $tel.attr('flag') + '"]', $box);
			
			// Костыль для телефонов по которым не определяется страна
			if($tel.val() && !checkPattern($used.data('pattern'), $tel.val())) {
				var $unknown = $('<li><a data-min="7" data-limit="18" data-flag="" data-code="" data-pattern="^\\d+$"><span class="flag"></span><span class="country">Unknown</span><span class="code"></span></a></li>');
				$used = $unknown.find('a');
				$('ul>li:eq(0)', $box).before($unknown);
			}

			if ($used.length) {
				setFlag($used);
			} else {
				$('li:first > a', $box).trigger('click');
			}
		});
	};
