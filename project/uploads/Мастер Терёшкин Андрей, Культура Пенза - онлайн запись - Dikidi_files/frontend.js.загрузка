$(document).ready(function(){
	sw.apply('body');
}).on('hidden.bs.modal', function(e) {
	if ($('body > .modal.in').length == 0) {
		$('body').css('padding-right', '').removeClass('modal-open');
	} else {
		$('body').addClass('modal-open');
	}
}).on('mouseup', function(e){
	if ($(e.target).closest('.country-list').length == 0) {
		$('ul.country-list:not(.hide)').addClass('hide');
	}
}).on('click', '.more a', function(event) {
	var $form = $(this).closest('form'),
		$more = $('input[name="more"]', $form),
		$offset = $('input[name="offset"]', $form),
		$limit = $('input[name="limit"]', $form);
	
	$offset.val(parseInt($offset.val()) + parseInt($limit.val()));
	
	$more.val(1);
	$form.trigger('submit');
	$more.val(0);
	
	$(this).closest('.more').remove();
});

