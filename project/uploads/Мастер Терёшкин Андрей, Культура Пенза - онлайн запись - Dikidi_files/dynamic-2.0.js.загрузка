				if (el) {
					options.onRemove(el)
				}
				
				$.error(ob.message);
			},
			onProgress: function(event) {
				var progress = event.loaded.toString() + ' bytes transfered';
				
				if (event.lengthComputable) {
					progress = Math.round(event.loaded / event.total * 100).toString() + '%';
				}
				
				/*console.log(event.loaded.toString());*/
			},
			getQuery: function() {
				return $.param({
					v: options.version
				});
			},
			onCrop: function(ob, el) {
				var id, key, link, crop = {x: 0, y: 0, w: 0, h: 0, r: 0};

				if (options.version > 1) {
					id = ob[0];
					key = ob[3];
					link = ob[2];
				} else {
					id = ob.file[1];
					key = ob.key;
					link = options.server + ob.file[2] + '.jpg';
				}

				$html = $('<h3>' + __('Область изображения') + '</h3><link type="text/css" href="/assets/global/include/cropper/cropper.min.css" rel="stylesheet" /><div class="form-group"><img class="image" src="' + link + '"></div><div class="form-group btns sw"><button type="button" class="btn btn-primary">' + __('Сохранить') + '</button></div>')
				
				$.cachedScript('/assets/global/include/cropper/cropper.min.js').done(function() {
					options.cropper = $.extend(options.cropper, {
						crop: function(e) {
							crop.x = e.x;
							crop.y = e.y;
							crop.w = e.width;
							crop.h = e.height;
							crop.r = e.rotate;
						}
					});
					
					$('img', $html).cropper(options.cropper);
				});
				
				var dialog = bootbox.dialog({
					message: $html,
					backdrop: $('body .modal-backdrop').length ? false : true,
					animate: false,
					className: 'sw-dialog cropper durable',
				});

				$('.btn', $html).on('click', function() {
					sw.ajax({
						url: options.server + 'cropper/?' + options.getQuery(),
						loader: $('.modal.cropper .modal-dialog'),
						data: {
							crop: crop,
							file: id,
							key: key,
						},
						success: function(obj) {
							options.onCroped(ob, el);
							
							dialog.modal('hide');
						},
						error: function(ob) {
							options.onError({
								code: ob.code,
								message: ob.message,
							});
						}
					}, 'post');
				});
			},
			onCroped: function(ob, el) {
				options.onApply(ob, el);
				options.onDone(ob, el);
			},
			onChanged: function(files) {
				var accept;
				
				if (options.accept) {
					if (Array.isArray(options.accept)) {
						accept = options.accept;
					} else {
						accept = options.accept.slice(0, -1);
					}
				} else {
					accept = false;
				}
				
				var count_files = files.length;
				var result = [];

				for (var i = 0; i < count_files; i++) {
					if (accept) {
						if (Array.isArray(accept)) {
							if (accept.indexOf(files[i].type) === -1) {
								continue;
							}
						} else {
							if (files[i].type.indexOf(accept) !== 0) {
								continue;
							}
						}
					}

					var xhr = new XMLHttpRequest(),
						form = new FormData();
					
					var file = {
						name: files[i].name,
						exp: files[i].name.substr(files[i].name.lastIndexOf('.') + 1),
						type: files[i].type.substr(0, files[i].type.indexOf('/')),
						mime: files[i].type,
						size: files[i].size,
						lastModified: files[i].lastModified,
					};
					
					xhr.open('POST', options.server + 'upload/?' + options.getQuery(), true);
					
					if (options.multiple) {
						xhr.box = options.onAppend(file);
					} else {
						xhr.box = options.container;
					}
					
					xhr.onprogress = function(event) {
						options.onProgress(event);
					}
					
					xhr.onload = function(r) {
						var ob = JSON.parse(r.target.responseText), obj;
						
						if ('error' in ob && ob.error.code) {
							options.onError({
								code: ob.error.code,
								message: ob.error.message,
							}, r.target.box);
							
							return false;
						}

						if (options.version < 2) {
							obj = {
								type: ob.data[0],
								file: JSON.parse(ob.data[1]),
								key: ob.data[2],
							};
						} else {
							obj = ob.data;
						}
						
						if (options.cropper) {
							options.onCrop(obj, r.target.box);
						} else {
							options.onApply(obj, r.target.box);
							options.onDone(obj, r.target.box);
						}
						
						result.push(obj);
						
						if (result.length == count_files) {
							options.onCompleted(result);
						}
					}
					
					if (options.cropper) {
						form.append('crop', true);
					}
					
					form.append('file', files[i]);
					
					xhr.send(form);
				}
            },
        }, options);
        
		if (!options.server) {
			$.error('Не задан сервер для jQuery.upload');
		}
		
		if (!options.container) {
			$.error('Не задан контейнер для jQuery.upload');
		}
		
		options.container.on('click', '.remove', function(e) {
            e.stopPropagation();
            
			var $el = $(this).parent().parent();
			
			if (options.isRemoveConfirm) {
				sw.confirm({
					title: __('Подтверждение удаления'),
					text: __('Действительно удалить файл?'),
					noFocus: options.confirmButtonsNoFocus,
					yes: function() {
						options.onRemove($el);
					}
				});
			} else {
				options.onRemove($el);
			}
		});
		
        var make = function() {
        	var $file = $('<input type="file" />');
        	
			if (options.multiple) {
				$file.attr('multiple', true);
			}
			
			if (options.accept) {
				$file.attr('accept', options.accept);
			}
        	
			$file.on('change', function() {
				return options.onChanged($(this).prop('files'));
			});
        	
			$(this).on('click', function() {
				$file.trigger('click');
			});
        }
        
        return this.each(make);
	};
})(jQuery);

(function($){
	$.fn.formElegant = function(){
		this.each(function() {
			if (this.value.length) {
				$(this).siblings('label').addClass('active');
			}
		});
		
		this.on('focus', function() {
			$(this).siblings('label').addClass('active');
		}).on('blur', function() {
			if (!this.value.length) {
				$(this).siblings('label').removeClass('active');
			}
		});
	};
})(jQuery);

(function($){
    $.fn.serializeObject = function(){
        var self = this,
            json = {},
            push_counters = {},
            patterns = {
                "validate": /^[a-zA-Z][a-zA-Z0-9_]*(?:\[(?:\d*|[a-zA-Z0-9_]+)\])*$/,
                "key":      /[a-zA-Z0-9_]+|(?=\[\])/g,
                "push":     /^$/,
                "fixed":    /^\d+$/,
                "named":    /^[a-zA-Z0-9_]+$/
            };

        this.build = function(base, key, value){
            base[key] = value;
            return base;
        };

        this.push_counter = function(key){
            if(push_counters[key] === undefined){
                push_counters[key] = 0;
            }
            return push_counters[key]++;
        };

        $.each($(this).serializeArray(), function(){

            // skip invalid keys
            if(!patterns.validate.test(this.name)){
                return;
            }

            var k,
                keys = this.name.match(patterns.key),
                merge = this.value,
                reverse_key = this.name;

            while((k = keys.pop()) !== undefined){

                // adjust reverse_key
                reverse_key = reverse_key.replace(new RegExp("\\[" + k + "\\]$"), '');

                // push
                if(k.match(patterns.push)){
                    merge = self.build([], self.push_counter(reverse_key), merge);
                }

                // fixed
                else if(k.match(patterns.fixed)){
                    merge = self.build([], k, merge);
                }

                // named
                else if(k.match(patterns.named)){
                    merge = self.build({}, k, merge);
                }
            }

            json = $.extend(true, json, merge);
        });

        return json;
    };
})(jQuery);

function sideModal(options) {
	const defaults = {
		animate: true,
		container: "body",
		content:
			'<div class="modal-skeleton">' +
				'<div class="modal-header">' +
					'<div class="skeleton-loader"></div>' +
				'</div>' +
				'<div class="modal-body">' +
					'<div class="skeleton-loader heading"></div>' +
					'<div class="skeleton-loader"></div>' +
					'<div class="skeleton-loader"></div>' +
				'</div>' +
			'</div>',
		timer: 500,
	};
	
	options = $.extend({}, defaults, options);
	
	let modal = $('> .side-modal', options.container);
	
	if (modal.length === 0) {
		modal = $(
			'<div class="side-modal animate">' +
				'<div class="modal-dialog">' +
					'<div class="modal-content">' +
						'<div class="modal-body"></div>' +
					'</div>' +
				'</div>' +
			'</div>'
		);
		
		$('.modal-content .modal-body', modal).html(options.skeleton);
		
		modal.on('click', '.modal-close', () => modal.trigger('hide.side.modal'));
		
		modal.on('hide.side.modal', () => {
			modal.removeClass('in');
			setTimeout(() => {
				modal.trigger('hidden.side.modal');
			}, options.timer);
		});
		
		modal.on('hidden.side.modal', () => {
			modal.remove();
		});
		
		modal.on('show.side.modal', () => {
			setTimeout(() => modal.addClass('in'), 1);
			setTimeout(() => modal.trigger('shown.side.modal'), options.timer);
		});
		
		$(options.container).append(modal);
		
		modal.trigger('show.side.modal');
	}
	
	$event.on('clicked.out.main.side-modal', (e, el) => {
		let isSideArea = $(el.target).closest('.side-modal').length > 0;
		let pickerCornerClick = window.pickerCornerClick;
		let isModalOpen = $('body > .modal:visible').length > 0;

		if (!isSideArea && !pickerCornerClick && !isModalOpen) {
			modal.trigger('hide.side.modal');
		}

		if (window.pickerCornerClick) window.pickerCornerClick = false;
	});
	
	modal.on('destroyed', () => $event.off('clicked.out.main.side-modal'));
	
	$('.modal-content .modal-body', modal).html(options.content);
	
	return modal;
}
