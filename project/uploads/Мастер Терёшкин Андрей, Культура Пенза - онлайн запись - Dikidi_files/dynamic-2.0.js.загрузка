}).on('click', '*[data-remove]', function() {
	var link = this,
		yes_btn = $(link).data('yes-btn'),
		no_btn = $(link).data('no-btn'),
		title = $(link).data('title'),
		text = $(link).data('text');
	
	sw.confirm({
		title: title ? title : __('Подтверждение удаления'),
		text: text ? text : __('Удалить выбранный элемент списка?'),
		yes: function() {
			var $loader = $(link).data('loader');
			var hasLoader = !!$loader;
			if(!hasLoader) {
				$loader = $('<div></div>');
				$loader.css({position:'fixed', left:0, top:0, right:0, bottom:0, 'z-index': 99999});
				$('body').append($loader);
			}
			
			sw.ajax({
				url: $(link).data('remove'),
				data: getFormToVariable($(link).attr('data-filter') ? $($(link).attr('data-filter')) : $(link).closest('form.options'), 'filter'),
				loader: $loader,
				element: link
			}, 'get').always(function() {
				if(!hasLoader) {
					$($loader).remove();
				}
			});
		},
		yes_title: yes_btn,
		no_title: no_btn,
	});
}).on('click', '*[data-href]', function(event) {
	event.preventDefault();
	
	var $this = $(this);
	
	var param = {
		url: $this.data('href'),
		loader: false,
	};
	
	if ($this.is('[data-propagation]')) {
		event.stopPropagation();
	}
	
	if ($this.is('[data-loader]')) {
		param.loader = $this.data('loader') != 'this' ? $this.data('loader') : $this;
	}
	
	if ($this.is('[data-post]')) {
		param.data = $this.data('post');
	}
	
	if ($this.attr('data-filter')) {
		param.data = getFormToVariable($this.data('filter'), 'filter');
	}
	
	if ($this.is('[data-toggle="side-modal"]')) {
		sideModal();
	}
	
	window.callbackElement = this;
	
	param.element = this;
	
	if ($this.attr('href')) {
		param.success = function() {
			var href = $(param.element).attr('href'),
				key = encodeURIComponent(href);
			
			if (!http.history[key]) {
				http.history[key] = $(param.element).data('href');
			}
			
			http.push({action: $(param.element).data('href')}, href);
			
			$('body > .modal').modal('hide');
		}
	}
	
	sw.ajax(param, $this.is('[data-post]') ? 'post' : 'get');
}).on('show.bs.modal', function(e) {
	if (!$(e.target).attr('sw-apply')) {
		$(e.target).attr('sw-apply', true);
		
		if ('base' in sw) {
			sw.base.apply(e.target);
		}
		
		sw.apply(e.target);
	}
}).on('shown.bs.modal', function(e) {
	if (!$('body > .template').hasClass('mobile')) {
		$('[tabindex="1"]', e.target).each(function(){
			$(this).focus().val($(this).val());
		});
	}
