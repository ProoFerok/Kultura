function formatPhone(phone)
{
	phone = phone.replace(/\D/g, '');
	
	var c = phone.length;
	
	if(c < 4) return phone;
	
	if(c <= 7) {
		phone = phone.replace(/(\d{1,3})?(\d{2})(\d{2})$/, '$1-$2-$3');
		
		phone = phone.replace(/^\-+/, '');
		
		return phone;
	}
	
	if(c < 10) {
		phone = phone.replace(/(\d{1,3})(\d{3})(\d{2})(\d{2})$/, '($1) $2-$3-$4');
		
		return phone;
	}
	
	if(c > 11) return phone;
	
	if( c == 11 && (phone[0] == '7' || phone[0] == '8') ) {
		phone = phone.replace(/^\d/, '');
	}
	
	if (phone[0] == "0") {
		phone = phone.replace(/(\d{3})(\d{3})(\d{2})(\d{2})$/, '($1) $2-$3-$4');
	} else {
		phone = phone.replace(/(\d{3})(\d{3})(\d{2})(\d{2})$/, '+7 ($1) $2-$3-$4');
	}
	
	return phone;
}

