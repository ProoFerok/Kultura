    fixDomain: function (url, isLocal) {
        if (!url) {
            return url;
        }

        var host = location.hostname;

        if (typeof isLocal != 'boolean') {
            isLocal = true;
        }

        var domains = ['dikidi.net', 'dikidi.app', 'dikidi.ru', 'dikidi.kz', 'dikidi.tech', 'dikidi.loc', 'dikidi.local'];

        for (var i in domains) {
            var current_domain = domains[i];
            if (host.indexOf(current_domain) < 0) {
                continue;
            }

            if (current_domain == 'dikidi.loc' && !isLocal) {
                current_domain = 'dikidi.tech';
            }

            for (var j in domains) {
                var search_domain = domains[j];
                if (current_domain != search_domain) {
                    url = url.replace(search_domain, current_domain);
                }
            }
        }

        return url;
    },
    verifyDomain: function (url, test) {
        return this.fixDomain(url, !test);
    },
    verifyImage: function (url, test) {
        return url ? this.verifyDomain(url, test) : url;
    },
    isTestServer: function () {
        return in_array(location.hostname, ['dikidi.loc', 'dikidi.tech']) || location.hostname.indexOf('dikidi.tech') > 0 || location.hostname.indexOf('dikidi.loc') > 0;
    },
    evalJS: function (js, data, element) {
