var $event = $({});

$(window).on('popstate', function(event) {
	if (event.originalEvent.state !== null && typeof(event.originalEvent.state) == 'object' && event.originalEvent.state.action) {
		$('.modal').modal('hide');
		
		if (event.originalEvent.state.data) {
			$event.trigger('history.push', event.originalEvent.state);
			
			if ('element' in event.originalEvent.state) {
				sw.ajax({
					url: event.originalEvent.state.action,
					data: event.originalEvent.state.data,
					element: $('form:eq(' + event.originalEvent.state.element + ')'),
					success: function(ob) {
						$event.trigger('history.success', {
							event: event.originalEvent.state,
							result: ob,
						});
					}
				}, 'get');
			}
		} else {
			sw.ajax({
				url: event.originalEvent.state.action,
			}, 'get');
		}
	}
});

