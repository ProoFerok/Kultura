	var json = getParameterByName('jn');
	
	if (json) {
		var jsonURL = getLocation(json);
		
		sw.ajax({
			url: jsonURL.pathname + jsonURL.search,
		}, 'get');
	}
	
	if(typeof(moment) != "undefined") {
		moment.fn.baseFormat = moment.fn.format;
		moment.fn.format = function (format) {
			var tmp = this.locale();
			
			if(!['hi'].includes(tmp)) {
				return moment.fn.baseFormat.apply(this, [format]);
			}
			
			var tokens = ['MMMM', 'MMM', 'Mo', 'Qo', 'Do', 'DDDo', 'dddd', 'ddd', 'dd', 'do',
				'wo', 'Wo', 'A', 'a', 'z', 'zz', 'NNNNN', 'NNNN', 'NNN', 'NN', 'N'];
			
			for (var i = 0; i < tokens.length; i++) {
				var reqexp = new RegExp(tokens[i], 'g');
				if(reqexp.test(format)) {
					format = format.replaceAll(reqexp, moment.fn.baseFormat.apply(this, [tokens[i]]));
				}
			}
			
			this.locale('ru');
			var result = moment.fn.baseFormat.apply(this, [format]);
			this.locale(tmp);
			
			return result;
		}
	}
}).on('hide.bs.modal', function() {
	var getURL = getLocationParams();
	
	if (getURL.jn && $('body > .modal.in').length == 1) {
		delete getURL.jn;
		
		var href = window.location.protocol + '//' + window.location.host + window.location.pathname;
		
		if (getURL) {
			href+= '?' + getAsUriParameters(getURL);
		}
		
		history.pushState({
