var sw = {
    ajaxAuth: function (ob, type) {
        if (ob.loader) {
            $(ob.loader).setLoader();
        }

        var hideLoader = function () {
            if (ob.loader) {
                $(ob.loader).removeLoader();
            }
        }

        var param = {
            url: ob.url,
            data: ob.data,
            type: type,
            dataType: 'json',
            xhrFields: {
                withCredentials: true,
            },
            crossDomain: true,
            success: function (obj) {
                if (typeof ob.success == 'function' && ob.success(obj.data)) {
                    return;
                }

                hideLoader();

                sw.result(obj, ob.element ? ob.element : null);
            },
            error: function (jqXHR) {
                if (typeof ob.error == 'function' && ob.error(jqXHR)) {
                    return;
                }

                hideLoader();

                if ('responseJSON' in jqXHR) {
                    if (typeof jqXHR.responseJSON.error == 'object') {
                        sw.alert(jqXHR.responseJSON.error.message);
                    } else {
                        sw.alert(jqXHR.responseJSON.message);
                    }
                }
            },
        };

        return $.ajax(param);
    },
    ajax: function (v, t, c) {
        if (!('loader' in v)) {
            v.loader = 'body';
        }

        if (v.loader) {
            $(v.loader).setLoader();
        }

        if (c == undefined) c = false;

        var ob = {
            url: v.url,
            type: t,
            dataType: 'json',
            data: v.data,
            async: v.async,
            success: function (data, jqXHR, textStatus) {
                data = data || {};

                var go = true;

                if (!data.redirect && !data.notRemoveLoader && v.loader) {
                    $(v.loader).removeLoader();
                }

                if (typeof data.error == 'object') {
                    if (data.error.code) {
                        data.message = data.error.message;
                        data.code = data.error.code;
                        data.error = 1;
                    } else {
                        data.error = 0;
                    }
                }

                if (!data.error && typeof v.success == 'function') {
                    v.success(data);
                }

                if (data.error == true && typeof v.error == 'function') {
                    if (v.error(data, jqXHR) === false) {
                        go = false;
                    }
                }

                if (go) {
                    if (data.confirm && data.yes_callback == 'reload-ajax') {
                        data.yes_callback = function () {
                            var parser = document.createElement('a');
                            parser.href = v.url;

                            parser.search = (parser.search + '&' + data.yes_query_addition).replace(/^\&/, '?');

                            v.url = parser.href;

                            sw.ajax(v, t);
                        }
                    }

                    sw.result(data, v.element ? v.element : null);
                }

                if (!data.error && typeof v.successAfterRender == 'function') {
                    v.successAfterRender(data);
                }
            },
            error: function (jqXHR) {
                if (v.loader) {
                    $(v.loader).removeLoader();
                }

                if (typeof v.error == 'function') {
                    v.error({}, jqXHR);
                }

                if ('responseJSON' in jqXHR) {
                    var ob = jqXHR.responseJSON;

                    if (typeof ob == 'object' && 'error' in ob && 'message' in ob.error) {
                        if (v.errorClass) {
                            sw.alert(ob.error.message, v.errorClass);
                        } else {
                            sw.alert(ob.error.message);
                        }
                    }
                }
            }
        };

        if (c) {
            ob.crossDomain = true;
            ob.xhrFields = {
                withCredentials: true
            };
        }

        return $.ajax(ob);
    },
    post: function (v) {
        return sw.ajax(v, 'post');
    },
    get: function (v) {
        return sw.ajax(v, 'get');
    },
    result: function (data, element) {
        if (data.message) {
            sw.alert(data.message, data.class);
        }

        if (data.event) {
            if (Array.isArray(data.event)) {
                for (var k in data.event) {
                    if (!data.event.hasOwnProperty(k)) continue;
                    $event.trigger(data.event[k]['name'], data.event[k]['data']);
                }
            } else {
                for (topic in data.event) {
                    $event.trigger(topic, data.event[topic]);
                }
            }
        }

        if (data.confirm) {
            sw.confirm({
                text: data.confirm,
                yes: function () {
                    if (!data.yes_callback) return;

                    if ($.isArray(data.yes_callback)) {
                        for (k in data.yes_callback) {
                            eval(data.yes_callback[k]);
                        }
                    } else {
                        if (typeof data.yes_callback == 'function') {
                            data.yes_callback();
                        } else {
                            eval(data.yes_callback);
                        }
                    }
                }
            });
        }

        if (data.captcha) {
            sw.captcha.show(data.captcha, function () {
                if (data.completed) {
                    setTimeout(function () {
                        sw.result(data.completed, element);
                    }, 0);
                }
            });
        }

        if (data.title) {
            $('title').text(data.title + ($('.navbar .logo').attr('title') ? ' :: ' + $('.navbar .logo').attr('title') : ''));
        }

        if (data.html) {
            var scrollTop = $(window).scrollTop();

            if (data.container) {
                $(data.container).html(data.html);
                sw.base.apply(data.container);
                sw.apply(data.container);
                $(window).scrollTop(scrollTop);
            }

            if ('replace' in data) {
                $(data.replace).replaceWith(data.html);
                sw.base.apply(data.replace);
                sw.apply(data.replace);
            }

            if (data.prepend) {
                var $box = $(data.html);

                sw.base.apply($box);
                sw.apply($box);

                $(data.prepend).prepend($box);
                $(window).scrollTop(scrollTop);
            }

            if (data.append) {
                var $box = $(data.html);

                sw.base.apply($box);
                sw.apply($box);

                $(data.append).append($box);
                $(window).scrollTop(scrollTop);
            }

            if (data.dialog) {
                if ($('form', data.html).length != 0) {
                    data.dialog += ' durable';
                }

                var show_backdrop = !$('body .modal-backdrop').length || data.dialog.includes('backdrop');
                var dm = bootbox.dialog({
                    message: data.html,
                    backdrop: show_backdrop,
                    animate: true,
                    className: 'sw-dialog ' + data.dialog
                });

                if (data.hideModal) {
                    dm.on('hide-modal', function () {
                        eval(data.hideModal);
                    });
                }
            }

            if (data.dialog2) {
                var $dialog_container = $('<div></div>');

                bootbox.dialog({
                    message: data.html,
                    backdrop: $('body .modal-backdrop').length ? false : true,
                    animate: true,
                    className: 'sw-dialog ' + data.dialog2,
                    container: $dialog_container,
                    show: false
                })
                    .data('data', data);

                var $modal = $dialog_container.find('> .modal');

                $('body').append($modal);
                $modal.modal('show');
            }

            $(window).trigger('resize');
        }

        if (data.success) {
            data.success(data);
        }

        if (data.callback) {
            if ($.isArray(data.callback)) {
                for (k in data.callback) {
                    sw.evalJS(data.callback[k], data, element);
                }
            } else {
                sw.evalJS(data.callback, data, element);
            }
        }

        if (data.redirect) {
            location = data.redirect;
        }

        if (data.script) {
            if ($.isArray(data.script)) {
                for (k in data.script) {
                    sw.result(data.script[k]);
                }
            } else {
                eval(data.script);
            }
        }
    },
    alert: function (m, className, button_text, button_callback) {
        var message = escapeHtml(m);

        // Блокирование всплывашек с одинаковым текстовым сообщением
        function check_unique() {
            var is_unique = true;
            var m_text = $('<div>' + message + '</div>').html();
            $('body > .modal.in.sw-dialog.modal-alert').each(function () {
                var $text = $(this).find('.text');
                if ($text.length != 1) return;

                var text = $text.html();

                if (text == m_text) is_unique = false;
            });

            return is_unique;
        }

        if (!check_unique()) return;

        if (!button_text) {
            button_text = __('Ок');
        }

        var dialog = bootbox.dialog({
            message: '<h3>' + __('Внимание') + '</h3><div class="form-group text">' + message + '</div><div class="form-group btns sw"><button class="btn btn-primary bootbox-close-button">' + button_text + '</button></div>',
            backdrop: $('body .modal-backdrop').length ? false : true,
            animate: false,
            className: 'sw-dialog modal-alert' + ' ' + (className !== undefined ? className : '')
        });

        if (typeof button_callback == 'function') {
            $('.sw-dialog:last button.btn.bootbox-close-button').click(button_callback);
        }

        return dialog;
    },
    confirm: function (v) {
        bootbox.dialog({
            message: '<h3>' + (!v.title ? __('Внимание') : v.title) + '</h3><div class="form-group text">' + v.text + '</div><div class="form-group btns sw"><button class="btn ' + (v.noFocus ? 'btn-new-primary' : 'btn-primary') + ' bootbox-close-button">' + (!v.yes_title ? __('Да') : v.yes_title) + '</button><button class="btn ' + (v.noFocus ? 'btn-new-secondary' : 'btn-cancel') + ' bootbox-close-button">' + (!v.no_title ? __('Нет') : v.no_title) + '</button></div>',
            backdrop: $('body .modal-backdrop').length ? false : true,
            animate: false,
            className: 'sw-dialog confirm' + ' ' + (v.className !== undefined ? v.className : '')
        });

        $('.sw-dialog:last button.btn:first').click(function () {
            v.yes();
        });

        $('.sw-dialog:last button.btn:last').click(function () {
            if (v.no && typeof v.no == 'function')
                v.no();
        });
    },
