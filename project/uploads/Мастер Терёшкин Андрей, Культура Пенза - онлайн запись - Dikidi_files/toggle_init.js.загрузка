$().ready(function(){
	var init = function($self){
		var init_toggle = function($el){
			var toggles_str = $el.data('toggle');
			var toggles = toggles_str.split(' ');
			
			if($el.data('toggle-inited')) return;
			
			$.each(toggles, function(t_key, toggle){
				var func;
				toggle = toggle.replace(/\-/g, '_');
				
				try {
					eval('func = '+toggle+'_init');
				}
				catch(err) {
					console.log('Error', 'Toggle function "'+toggle+'_init" not found');
				}
				
				if(typeof(func)!=='function') return;
				
				func($el);
			});
			
			$el.data('toggle-inited', true);
		}
		
		if($self.is('*[data-toggle]')){
			init_toggle( $self );
		}
		
		if(!$self.is('input')){
			$self.find('*[data-toggle]').each(function(){
				init_toggle( $(this) );
			});
		}
	}
	
	init($(document));
	
	// Чтобы работало при динамическом добавлении контента
	var observer = new MutationObserver(function(mutations) {
		mutations.forEach(function(mutation) {
			init($(mutation.target));
		});
	});
	observer.observe(document.documentElement || document.body, {childList:true, subtree:true});
	
	// Инициализация FancyBox
	if(typeof $.fn.fancybox == 'function'){
		$('.fancybox').fancybox({
			prevEffect: 'none',
			nextEffect: 'none'
		});
	}
	
});

