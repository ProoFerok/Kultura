// Обновление для Bootstrap data-toggle="buttons".
// Добавляет вожожность отключить кнопку при использовании "radio".
// Для активации - нужно добавить параметр data-empty-enable=1
function buttons_init($el){
	if(!$el.data('empty-enable')) return;
	$el.on('click', '.btn', function(){
		var $self = $(this);
		var old_value = $self.find('input:checked').length;
		setTimeout(function(){
			var new_value = $self.find('input:checked').length;
			if(new_value>0 && old_value==new_value){
				$self.removeClass('active');
				$self.find('input:checked').prop('checked', false);
			}
		}, 0);
	});
}

function sw_remove_init($el){
	$el.click(function(){
		var text = $el.data('text');
		if(!text) text = 'Удалить ?';
		
		var href = $el.data('href');
		if(!href){
			sw.alert('Не указан атрибут data-href');
			return;
		}
		
		var loader = $el.data('loader');
		if(loader){
			loader = $el.closest(loader);
		}else{
			loader = $el.closest('li');
		}
		
		sw.confirm({
			text: text,
			yes: function(){
				sw.get({
					element: $el,
					loader: loader,
					url: href,
					success: function(){
						$el.closest('li').remove();
					}
				});
			}
		});
	});
}

function click_input_init($el){
	$el.click(function(){
		var href = $el.data('href');
		
		if(!href) sw.alert("Внимание: параметр data-href не указан");
		
		var value = $el.data('value');
		if(!value) value = $el.html();
		
		var name = $el.data('name');
		if(!name) name = 'value';
		
		var loader = $el.data('loader');
		if(loader) loader = $el.closest(loader);
		
		var html = '<input class="form-control" type="text" name="'+name+'" value="'+value+'" />';
		
		var $input = $('<input class="form-control" type="text" name="'+name+'" value="'+value+'" />');
		
		var sended = false;
		
		var change = function(){
			if(!href) return;
			if(sended) return;
			sended = true;
			
			var value = $input.val();
			var data = {};
			data[name] = value;
			sw.post({
				loader: loader,
				url: href,
				data: data,
				error: function(){
					sended = false;
					$('.modal').on('hidden.bs.modal', function (e) {
						$input.focus();
						$input.select();
					});
				}
			});
		};
		
		$input.focusout(function(){
			change();
		}).keyup(function(e) {
			if(e.keyCode == 13){
				change();
			}
		});
		
		var $button = $('<a class="persons_ok"><img src="/assets/images/actions/accept.png" alt="OK"></a>');
		$button.click(function(){
			change();
		});
		$el.parent().append($button);
		
		$el.replaceWith($input);

		$input.focus();
		$input.select();
		
	});
}

function selectpicker_init($el){
	// Выравнивание слева/справа выпадающего списка
	var menu_align = 'left';
	if($el.is('.dropdown-menu-right')){
		$el.removeClass('dropdown-menu-right');
		menu_align = 'right';
	}
	
	$el.selectpicker();
	
	// Статичный текст на кнопке
	if($el.data('button-text')){
		$el.next().find('button').text( $el.data('button-text') );
	}
	
	// Класс для кнопки
	if($el.data('button-class')){
		$el.next().find('button')
			.removeClass('btn btn-default')
			.addClass( $el.data('button-class') );
	}
	if($el.data('button-addclass')){
		$el.next().find('button')
			.addClass( $el.data('button-addclass') );
	}
	
	if(menu_align=='right'){
		$el.next().find('.dropdown-menu').addClass('dropdown-menu-right');
	}
	
	var timeout = false;
	
	var update = function(){
		if(timeout) clearTimeout(timeout);
		timeout = setTimeout(function(){
			$el.selectpicker('refresh');
			clearTimeout(timeout);
			timeout = false;
		}, 100);
	}
	
	// Чтобы нормально работал выбор
	$el.change(function(){
		update();
	});
	
	var observer = new MutationObserver(function(mutations) {
		update();
	});
	$el.each(function () {
		observer.observe(this, {childList:true, subtree:true});
	})
}

