function jsonForm_init($el){
	if(!$el.data('loader')){
		var loader = $el.parent();
		$el.data('loader', loader);
	}
	
	$el.submit(function(){
		sw.jsonForm($el);
		return false;
	});
}

function sw_change_init($el){
	var old_value;
	var run = function(value){
		var href = $el.data('href');
		if(!href){
			sw.alert('Параметр data-href не указан');
			return;
		}
		
		var loader = $el.data('loader');
		
		var name = $el.data('name');
		if(!name) name = 'value';
		
		var data = {};
		data[name] = value;
		
		sw.post({
			url: href,
			data: data,
			loader: loader,
			error: function(){
				if($el.is('select')){
					$el.val(old_value);
				}
			}
		});
	}
	
	if($el.is('select')){
		old_value = $el.val();
		$el.change(function(){
			var value = $el.val();
			run(value);
		});
	}
	
	if(
		$el.is('*[type=text]') ||
		$el.is('*[type=password]') ||
		$el.is('*[type=datetime]') ||
		$el.is('*[type=datetime-local]') ||
		$el.is('*[type=date]') ||
		$el.is('*[type=month]') ||
		$el.is('*[type=time]') ||
		$el.is('*[type=week]') ||
		$el.is('*[type=number]') ||
		$el.is('*[type=email]') ||
		$el.is('*[type=url]') ||
		$el.is('*[type=search]') ||
		$el.is('*[type=tel]') ||
		$el.is('*[type=color]')
	){
		var timeout;
		$el.on('textchange', function(event, previousText){
			clearTimeout(timeout);
			var self = this;
			timeout = setTimeout(function () {
				var value = $el.val();
				run(value);
			}, 1000);
		});
	}
}

function sw_search_init($el){
	var $input = $el.find('input');
	
	function check(){
		if($input.val()){
			$el.addClass('changed');
		}else{
			$el.removeClass('changed');
		}
	}
	
	$el.find('i[class$=remove]').click(function(){
		$input.val('').trigger('textchange');
	});
	
	$input.on('textchange', check);
	check();
}

function sw_switch_init($el){
	var $box = $el.siblings('.sw-switch');
	
	var run = function(){
		var state = parseInt($el.data('state'));
		if(state){
			$el.siblings('.sw-switch').show();
			$el.html( $el.data('text_hide') );
		}else{
			$el.siblings('.sw-switch').hide();
			$el.html( $el.data('text_show') );
		}
	};
	
	run();
	
	$el.click(function(){
		var state = parseInt($el.data('state'));
		if(state) state = 0;
		else state = 1;
		$el.data('state', state);
		run();
	});
}

function sw_get_init($el){
	var loader = $el.data('loader');
	
	$el.click(function(){
		var href = $el.data('href');
		sw.get({
			url: href,
			element: $el,
			loader: loader
		});
	});
}

