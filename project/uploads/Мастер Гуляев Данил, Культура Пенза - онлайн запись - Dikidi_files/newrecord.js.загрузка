	// Генератор опций для выбора времени (select-time)
	function gen_select_time(options){
		options = options || {};
		
		var $select_time = options.select_time;
		
		var master = options.master;
		
		//var appointments = options.appointments;
		
		var services = selected_services;
		
		if(!selected_day){
			selected_day = moment(current_datetime).startOf('day');
		}
		
		$select_time.html('<option></option>');
		
		if(_.isEmpty(times)) return;
		
		var options = {};
		
		$.each(times[master.id], function(key, time){
			var time_only = time.split(' ')[1];
			options[time_only] = time_only.replace(/^(\d+\:\d+).*$/, '$1');
		});
		
		if(!Object.keys(options).length) return;
		
		$.each(options, function(value, title){
			var $option = $('<option></option>')
				.text(title)
				.attr('value', value)
				.appendTo($select_time);
			
			if(master.id==selected_master_id && value==selected_time){
				$option.prop('selected', true);
			}
			
		});
		
	}
	
	// Генератор опций для выбора времени (select-time)
	function _gen_select_time(options){
		options = options || {};
		
		var $select_time = options.select_time;
		
		var solarium = options.solarium;
		
		if(!selected_day){
			selected_day = moment(current_datetime).startOf('day');
		}
		
		var week = parseInt(selected_day.format('E'), 10);
		
		timework = {
			time_from: company_schedules[week].work_from,
			time_to: company_schedules[week].work_to
		}
		
		var seconds_from = time_to_seconds(timework.time_from);
		var seconds_to = time_to_seconds(timework.time_to);
		var period = parseInt(solarium.periodicity, 10) * 60;
		
		var options = {};
		var duration = period;
		
		if(!period) return;
		for(var sec=seconds_from; sec<=seconds_to-duration; sec+=period){
			
			var time = seconds_to_time(sec);
			var sec_to = sec + duration;
			
			var datetime_from = selected_day.format('YYYY-MM-DD')+' '+time;
			var datetime_to = selected_day.format('YYYY-MM-DD')+' '+seconds_to_time(sec_to);
			
			// Прошедшее время и "Начало записи онлайн не ранее чем"
			if(moment(selected_day.format('YYYY-MM-DD')+' '+time).unix() < current_datetime.unix()+company_mintime*60)
				continue;
			
			// Проверка на "время свободно"
			var _break = true;
			$.each(freetime, function(key, free){
				if(free.solarium_id != solarium.id) return;
				
				if(
					free.datetime_from <= datetime_from &&
					free.datetime_to >= datetime_to
				) _break = false;
			});
			if(_break) continue;
			
			options[time] = time.replace(/^(\d+\:\d+).*$/, '$1');
		}
		
		$select_time.html('<option></option>');
		
		if(!Object.keys(options).length) return;
		
		$.each(options, function(value, title){
			var $option = $('<option></option>')
				.text(title)
				.attr('value', value)
				.appendTo($select_time);
			
