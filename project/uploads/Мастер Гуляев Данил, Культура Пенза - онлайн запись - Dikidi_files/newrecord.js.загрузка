		confirmation: function(options){
			show_page_before();
			current_page = 'confirmation';
			$breadcrumb = get_block.breadcrumb_main();
			
			function show(){
				var selected_datetime = [selected_day.format('YYYY-MM-DD'), selected_time].join(' ');
				
				var current_datetime_str = current_datetime.format('YYYY-MM-DD HH:mm:ss');
				
				var $remind = $confirmation.find('select[name="remind[]"]');
				
				$remind.find('option').each(function(){
					var $this = $(this);
					var minutes = parseInt($this.attr('value'), 10);
					
					var remind_datetime_str = moment(selected_datetime)
						.subtract(minutes, 'minutes')
						.format('YYYY-MM-DD HH:mm:ss');

					var selected = false;
					
					if(remind_datetime_str < current_datetime_str){
						$this.attr('disabled', 'disabled');
					}else{
						$this.removeAttr('disabled');
						
						if (default_remind.indexOf(minutes) != -1) {
							selected = true;
						}
					}

					$this.prop('selected', selected);
				});
				
				$remind.selectpicker();
				
				var lastVals = [];
				$remind.change(function() {
					// сильное колдунство с сохранением предыдущего состояния селекта
					var vals = $remind.val() || [];
					if(lastVals[0] == '0' && lastVals.length == 1 && vals.length > 1) {
						vals.splice(0, 1);
						$remind.selectpicker('val', vals);
					}
					if(vals.length == 0 || vals[0]=='0') {
						$remind.selectpicker('val', [0]);
					}
					// дизаблим варианты
					vals = $remind.val();
					$remind.find('option').each(function() {
						var $this = $(this);
						var minutes = $this.attr('value');
						var remind_datetime_str = moment(selected_datetime)
							.subtract(minutes, 'minutes')
							.format('YYYY-MM-DD HH:mm:ss');
						if(remind_datetime_str < current_datetime_str) {
							$this.attr('disabled', 'disabled');
						}
						else if (minutes != '0' && vals.length >= 2 && vals.indexOf(minutes) == -1) {
							$this.attr('disabled', 'disabled');
						}
						else {
							$this.removeAttr('disabled');
						}
					});
					$remind.selectpicker('refresh');
					lastVals = vals;
				});
				
				$remind.change();
				
				var $color_label = $confirmation.find('select[name=color_label_id]');
				$color_label.val(default_color_label_id);
				$color_label.change();
				
				$mainbox.html('')
					.append($breadcrumb)
					.append($confirmation)
					;
				
				var $client_phone = $confirmation.find('input[name=client_phone]');
				
				$client_phone.on('textchange', function(){
					if($client_phone.is('[data-is-mobile]')) {
						if(parseInt($client_phone.attr('data-is-mobile'), 10)) {
							$remind.removeAttr('disabled');
						} else {
							$remind.val('');
							$remind.attr('disabled', 'disabled');
						}
						$remind.selectpicker('refresh');
					}
				});
				
				auto_height();
			}
			
			if(!$confirmation){
				$confirmation = get_block.confirmation();
			}
			
			if(!diff_selected_old()){
				show();
				return;
			}
			
			set_selected_old();
			
			var time = [selected_day.format('YYYY-MM-DD'), selected_time].join(' ');
			
			if(category_id == the_solarium_id){
				var url = url_prefix+'/ajax/newrecord/solarium_time_reservation/';
				var data = {
					company_id: company_id,
					solarium_id: selected_solarium_id,
					time: time,
					action_source_id: action_source_id,
					'is-from-journal': is_from_journal,
					'unique_key': unique_key
				}
