	function services_update_link(options){
		options = options || {};
		
		var floating = false;
		var cost = 0;
		$.each(selected_services, function(k, service){
			cost += parseInt(service.cost, 10);
			
			if(parseInt(service.floating, 10)){
				floating = true;
			}
		});
		
		var $_footer_buttons = options.$footer_buttons || $footer_buttons;
		
		if(!selected_services.length){
			$_footer_buttons.find('.services_selected_link').hide();
			$_footer_buttons.find('.services_selected').hide();
		}else{
			$_footer_buttons.find('.services_selected_link').show();
		}
		
		var text = __('Выбрано услуг: :services на сумму', {':services': selected_services.length}) + ' ' + (floating ? __('от') + ' ' : '') + cost+' '+currency.abbr;
		
		$_footer_buttons.find('.services_selected_link').html(text);
	}
	
	function service_insert(service_id){
		selected_services_id.push(service_id);
		selected_services.push(services[service_id]);
		
		var service = services[service_id];
		
		var $services_selected = $footer_buttons.find('.services_selected');
		
		$services_selected.find('.list').append( [
			'<li data-service-id="'+service.id+'">',
				'<span class="service">'+service.title+'</span>',
				'<span class="price">'+(parseInt(service.floating, 10) ? __('от')+' ' : '')+' '+service.cost+' '+currency.abbr+'</span>',
				'<a class="action_remove"><i class="glyphicon glyphicon-remove-sign"></i></a>',
			'</li>',
		].join('') );
		
		services_update_link();
	}
	
	function service_remove(service_id){
		for(var k in selected_services){
			if(selected_services[k].id != service_id) continue;
			
			selected_services.splice(k, 1);
			
			break;
		}
		
		selected_services_id = [];
		$.each(selected_services, function(k, service){
			selected_services_id.push(service.id.toString());
		});
		
		var $services_selected = $footer_buttons.find('.services_selected');
		
		setTimeout(function(){
			$services_selected.find('li[data-service-id='+service_id+']').remove();
			$services.find('li[data-service-id='+service_id+']').removeClass('active');
		}, 0);
		
		services_update_link();
	}
	
	
