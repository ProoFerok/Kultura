// Выбор времени
(function(){
	var $selects = [];
	
	function selects_reset(){
		$.each($selects, function(key, $select){
			if(!$select.val()) return;
			$select.val('').change();
		});
	}
	
	newrecord_select_time_init = function($el){
		var $select = $el.hide();
		var times = {};
		var $box = $('<div class="select-time"></div>');
		
		function show_dropdown($button, times){
			var $modal = $('<div class="modal modal-record-select-time"></div>')
				.data('backdrop', false)
				.addClass($el.data('modal-class'))
				.click(function(e){
					if(e.target!=this) return;
					$modal.modal('hide')
				})
				;
			var $dialog = $('<div class="modal-dialog-free"></div>')
				.appendTo($modal);
			var $ul = $('<ul class="nav nav-pills nav-stacked"></ul>')
				.appendTo($dialog);
			
			$.each(times, function(key, time){
				var title = moment(time.title, 'HH:mm').format(backend.user.time_format);
				var $li = $('<li></li>')
					.appendTo($ul);
				var $a = $('<button type="button" class="btn btn-xs btn-default"></button>').text(title)
					.appendTo($li)
					.click(function(){
						selects_reset();
						$select.val(time.value).change();
						$modal.modal('hide');
					});
				if(time.option.prop('selected')){
					$a.addClass('active');
				}
			});
			
			$modal.appendTo('body');
			
			$modal.modal('show');
			
			function set_position(){
				$dialog
					.css('margin', 0)
					.position({
						my: 'center top',
						at: 'center',
						of: $button,
						collision: 'none'
					})
					.css('margin', '');
			}
			
			$(window).on('resize', set_position);
			
			$modal.on('hidden.bs.modal', function(){
				$(window).off('resize', set_position);
				$modal.remove();
			});
			
			set_position();
		}
		
		function render_box(){
			if(!Object.keys(times).length){
				$box.html([
					'<div class="t1">' + __('К сожалению, в настоящее время запись невозможна – нет свободного времени!') + '</div>',
					'<div class="t2">' + __('Пожалуйста, попробуйте позже или выберите другое место для записи.') + '</div>'
				].join(''));
				return;
			}
			
			$box.html('');
			$.each(times, function(i, row){
				var $row = $('<div class="row"></div>')
					.appendTo($box);
				
				var $header = $('<div class="select-time-header"></div>')
					.appendTo($row);
				
				if(i=='0'){
					$header.text(__('Ночь')+':')
				}
				if(i=='1'){
					$header.text(__('Утро')+':')
				}
				if(i=='2'){
					$header.text(__('День')+':')
				}
				if(i=='3'){
					$header.text(__('Вечер')+':')
				}

				$.each(row, function(hour, times){
					var title = times[ Object.keys(times)[0] ].title;
					var $button = $('<button type="button" class="btn btn-xs btn-default"></button>')
						.html(moment(title, 'HH:mm').format(backend.user.time_format))
						.appendTo($row)
						.click(function(){
							if(Object.keys(times).length==1){
								$.each(times, function(key, time){
									selects_reset();
									$select.val( times[ Object.keys(times)[0] ].value ).change();
								});
								return;
							}
							show_dropdown($button, times);
						});
					$.each(times, function(key, time){
						if(time.option.prop('selected')){
							$button.addClass('active')
								.html(moment(time.title, 'HH:mm').format(backend.user.time_format));
						}
					});
				});
			});
		}
		
		$selects.push($select);
		
		function update(){
			times = {};
			$select.find('option').each(function(){
				var $option = $(this);
				var title = $option.html();
				var value = $option.val();
				
				if(!value) return;
				
				var r = value.match(/^(\d+)\:(\d+)/);
				if(r.length<3) return;
				var hour = parseInt(r[1], 10);
				var min = parseInt(r[2], 10);
				var i = Math.floor(hour/6);
				
				if(!times[i]){
					times[i] = {};
				}
				
				if(!times[i][hour]){
					times[i][hour] = {};
				}
				
				times[i][hour][min] = {
					title: title,
					value: value,
					option: $option
				};
			});
			
			render_box();
		}
		
		update();
		$select
			.change(render_box)
			.on('update', update)
			.after($box);
	};
})();


