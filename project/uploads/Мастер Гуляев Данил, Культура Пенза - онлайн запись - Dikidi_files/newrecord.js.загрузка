					master_id: selected_master_id,
					services_id: selected_services_id,
					time: time,
					action_source_id: action_source_id,
					'is-from-journal': is_from_journal,
					'unique_key': unique_key
				}
			}
			
			sw.get({
				url: url,
				loader: $mainbox,
