										company_id: company_id,
										master_id: selected_master_id,
										services_id: selected_services_id,
										date: selected_day.format('YYYY-MM-DD'),
										action_source_id: action_source_id,
										is_show_all_times: is_show_all_times,
										'is-from-journal': is_from_journal,
									},
									success: function(data){
										times = data.times;
										selected_times = times;
										
										gen_times();
										
										$select_time.trigger('update');
									}
								}, 'get');
								
								return;
							}
							
						}
						
						$datepicker.datepicker('setDate', date);
						gen_times();
						
						$select_time.trigger('update');
						
						//$modal.modal('hide');
						
						//show_page.select_master();
						
						//obj.set_date( unixtime );
					}
				});
			}, 0);
			
			$select_time.change(function(){
				var time = $select_time.val();
				if(!time) return;
				
				selected_time = time;
				
				selected_calendar_dates_true = calendar_dates_true;
				
				if(is_beta){
					selected_appointments = appointments;
					selected_timeworks = timeworks;
				}else{
					selected_times = times;
				}

				show_page.confirmation();
				//checked_next();
				//breadcrumb_main_refresh();
			});
			
			$html.find('#show-all-times').prop('checked', !is_show_all_times);
			
			$html.on('change', '#show-all-times', function(){
				is_show_all_times = $(this).prop('checked') ? 0 : 1;
				show_page.to_master_select_datetime();
			});
			
			return $html;
		}
	};
	
