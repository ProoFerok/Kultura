			dates_true = data_main.dates_true;
			solariums = data_main.solariums;
			freetime = data_main.freetime;

			is_select_services_disable = true;

			selected_day = moment(dates_true[0], 'YYYY-MM-DD');

			show_page.select_solarium({skip_load: true});
		}else if(current_page=='to_service_select_service') {
			category_id = data_main['category_id'];
			categories = data_main.categories;
			selected_category = categories[category_id];
			services = data_main.services;
			sorted_services_id = data_main['sorted_services_id'];

			show_page.services({skip_load: true});
		}else if(current_page=='select_company') {
			is_close_enabled = true;
			companies = data_main['companies'];
			show_page.select_company();
		}else{
			show_page.select_to();
			categories = data_main.categories;
		}
	}
	
	$el.on('animationend', function(e){
		$(e.target).removeClass('animate');
	});
	
	// Костыль. При анимации модального окна, из-за того
	// что элементы не сразу отображаются - баг с высотой
	var interval;
	if(!$modal.is(':visible')) {
		interval = setInterval(function(){
			if(!$modal.is(':visible')) return;
			clearInterval(interval);
			start_show();
		}, 50);
	} else {
		start_show();
	}
}

function newrecord_mobile_number_init($el)
{
	sw.apply($el.closest('.mobile-number').parent());
	
	// TODO поправить - костыль чтобы событие textchange было на hidden
	$el.closest('.mobile-number').find('input[type="text"]')
		.on('textchange', function(e){
			setTimeout(function(){
				$el.closest('.mobile-number').find('input[type="hidden"]')
					.trigger('textchange');
			}, 0);
		});
}


