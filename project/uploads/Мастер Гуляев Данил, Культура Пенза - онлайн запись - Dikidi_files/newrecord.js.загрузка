				var title = service.title;
				
				if(services_search_filter){
					var s = services_search_filter.toLowerCase();
					if(title.toLowerCase().indexOf(s) == -1) return;
				}
				
				var $item = $item_tpl
					.clone()
					.attr('data-service-id', service_id);
				
				var $input = $item.find('input').val(service.id);
				
				function item_select(){
					//$box.find('>li').removeClass('active');
					$input.prop('checked', true);
					$item.addClass('active');
					
					if(selected_services_id.length){
						$footer_buttons.find('.next').removeAttr('disabled');
					}else{
						$footer_buttons.find('.next').attr('disabled', 'disabled');
					}
				}
				
				function item_unselect(){
					$input.prop('checked', false);
					$item.removeClass('active');
					
					if(selected_services_id.length){
						$footer_buttons.find('.next').removeAttr('disabled');
					}else{
						$footer_buttons.find('.next').attr('disabled', 'disabled');
					}
				}
				
				$item.click(function(){
					if(!is_to_master){
						selected_master_id = false;
					}
					reset_time();
					
					if(!is_to_master){
						selected_services_id = [service_id];
						selected_services = [services[service_id]];
						show_page.select_master();
						return;
					}
					
					if($.inArray(service_id, selected_services_id)==-1){
						var max_services_count = is_from_journal ? 30 : 5;
						if(selected_services_id.length>=max_services_count){
							sw.alert(__('Разрешен выбор не более :number услуг!', {':number':max_services_count}));
							return;
						}
						
						service_insert(service_id);
						item_select();
					}else{
						service_remove(service_id);
						item_unselect();
					}
					
					breadcrumb_main_refresh();
				});
				
				$item.find('.name').html(title);
				
				if(parseInt(service.floating, 10)){
					var cost = __('от') + ' '+numeral(service.cost).format();
				}else{
					var cost = numeral(service.cost).format();
				}
				
				$item.find('.time').html(
					(service.time_floating == 1 ? '<span class="time_floating">от</span> ' : '') 
					+ seconds_to_str( parseInt(service.time, 10)*60 )
				);
				
                $price = $item.find('.price');
                if(cost != 0) {
                    $item.find('.price').html(cost+' '+currency.abbr);
                } else {
                    $price.html(__('Бесплатно'))
                }
				
				
				//console.log(service_id, selected_services_id);
				
				if($.inArray(service_id, selected_services_id) != -1){
					setTimeout(function(){
						item_select();
					}, 0);
				}
				
				$box.append($item);
			});
			
			return $html;
		},
