		if(action_source_id == 3){
			height_box = height_window - 100;
		}else{
			height_box = height_window;
		}
		
		// Максимальный размер окна
		height_box = Math.min(height_box, 670);
		
		// Минимальный размер окна
		height_box = Math.max(height_box, 600);
		
		$bootbox_body.height(height_box);
		
	}
