
function newrecord_scroll_init($el){
	var $parent = $el.parent();
	
	$el.slimscroll({
		alwaysVisible: true,
		size: '3px',
		color: '#E5E5E5',
		opacity: 1
	});
	
	$el.mouseenter();
	
	function on_resize(){
		$el.outerHeight($parent.height(), true);
		$el.slimscroll();
	}
	
	$(window).on('resize', on_resize);
	
	$el.on('destroyed', function(){
		$el.mouseleave();
		$(window).off('resize', on_resize);
	});
	
	$el.css('height', '0');
	
	setTimeout(function(){
		$el.outerHeight($parent.height(), true);
	}, 0);
}

function newrecord_divisor_init($el){
	var $ul = $el;
	var $ul_empty = $('<ul></ul>').attr('class', $ul.attr('class'));
	var $html = $('<div class="newrecord-divisor"></div>');
	
	var $ul_new;
	
	$ul.find('> li').each(function(key){
		var $li = $(this);
		
		if(key % 3 == 0){
			$ul_new = $ul_empty.clone()
				.appendTo($html);
		}
		
		$ul_new.append($li);

	});
	
	$el.replaceWith($html);
}

