	function set_datepicker(options){
		options = options || {};
		
		var $datepicker = options.datepicker;
		var $loader = options.loader;
		var onSelect = options.onSelect;
		var master_id = options.master_id;
		
		var old_year = false;
		var old_month = false;

		function datepicker_load(year, month){
			if(
				old_year===false || old_month===false
			){
				if(is_to_master){
					$datepicker.datepicker('refresh');
					old_year = year;
					old_month = month;
					return;
				}
			}
			
			$loader.setLoader();
			
			var data = {
				company_id: company_id,
				year: year,
				month: month,
				action_source_id: action_source_id,
				'is-from-journal': is_from_journal,
			};
			
			if(category_id != the_solarium_id){
				data.services_id = selected_services_id;
			}
			
			if(is_to_master && master_id){
				data.master_id = master_id;
			}
			
			calendar_dates_true = [];
			
			if(is_to_master){
				var url = url_prefix+'/ajax/newrecord/to_master_get_datetime/';
			}else{
				if(category_id == the_solarium_id){
					var url = url_prefix+'/ajax/newrecord/get_solarium_dates_true/';
				}else{
					var url = url_prefix+'/ajax/newrecord/get_dates_true/';
				}
			}
			
			sw.get({
				url: url,
				data: data,
				loader: $(),
				success: function(data){
					$loader.removeLoader();
					
					calendar_dates_true = data.dates_true;
					
					if(data.appointments){
						appointments = data.appointments;
					}
					
					if(data.timeworks){
						timeworks = data.timeworks;
					}
					
					$datepicker.datepicker('refresh');
					
					if(is_to_master){
						reset_time();
						
						if(calendar_dates_true.length){
							selected_day = moment(calendar_dates_true[0]);
							times = data.times;
						}else{
							selected_day = false;
							times = false;
						}
						
						breadcrumb_main_refresh();
						
						if(selected_day) {
							onSelect(selected_day.format('YYYY-MM-DD'));
						}else{
							onSelect(null);
						}
					}
				}
			});
			
			old_year = year;
			old_month = month;
		}
		
		$datepicker.datepicker({
			//defaultDate: moment.unix(date_show_unixtime).format('DD.MM.YYYY'),
			firstDay: backend.user.first_day,
			dateFormat: 'yy-mm-dd',
