			if(is_beta){
				//Преобразование информации о занятом времени
				var _appointments = [];
				
				$.each(appointments, function(key, appointment){
					var master_id = appointment.master_id;
					if(master_id != selected_master_id) return;
					_appointments.push(appointment);
				});
			}

			function gen_times(date){
				if(is_beta){
					gen_select_time({
						select_time: $select_time,
						appointments: _appointments,
						master: selected_master,
						date: date
					});
				}else{
					gen_select_time({
						select_time: $select_time,
						//appointments: _appointments,
						master: selected_master,
						date: date
					});
				}
			}
			
			gen_times();
			
			setTimeout(function(){
				set_datepicker({
					master_id: selected_master_id,
					datepicker: $datepicker,
					loader: $bootbox_body,
					onSelect: function(date) {
						//selected_master_id = '';
						
						if(!date){
							gen_times();
							$select_time.trigger('update');
							return;
						}
						
						if(selected_day.format('YYYY-MM-DD') != date){
							reset_time();
							selected_day = moment(date, 'YYYY-MM-DD');
							selected_old.date = date;
							breadcrumb_main_refresh();
							
							selected_calendar_dates_true = calendar_dates_true;
							
							if(is_beta){
								selected_appointments = appointments;
								selected_timeworks = timeworks;
							}else{
								sw.ajax({
									url: url_prefix+'/ajax/newrecord/get_times/',
