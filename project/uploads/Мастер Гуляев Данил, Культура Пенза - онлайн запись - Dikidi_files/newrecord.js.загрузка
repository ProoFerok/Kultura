			function validation($el){
				if(!$el){
					$el = $html.find('.required input');
				}
				
				var error = false;
				
				$el.each(function(){
					var $self = $(this);
					
					if($self.is('*[type=checkbox]')){
						var value = $self.prop('checked');
					}else{
						var value = $self.val();
					}
					
					var $form_group = $self.closest('.form-group');
					var $help_block = $form_group.find('.help-block').first();
					
					if($self.is('*[disabled]')) return;
					//if($self.is('*:hidden')) return;
					
					if(!value){
						error = true;
						
						if(!$help_block.length){
							$help_block = $('<div class="help-block"></div>')
								.data('for-remove', true);
							$form_group.append($help_block);
						}else{
							$help_block.data('old-html', $help_block.html());
						}
						
						var required_text = __('Это поле не должно быть пустым');
						if($self.data('required-text')){
							required_text = $self.data('required-text');
						}
						
						$help_block.html(required_text);
						
						$form_group.addClass('has-error');
							
					}else{
						var old_html = $help_block.data('old-html');
						if($help_block.data('for-remove')){
							$help_block.remove();
							$form_group.removeClass('has-error');
						}else if(old_html){
							$help_block.data('old-html', '');
							$help_block.html(old_html);
							$form_group.removeClass('has-error');
						}
					}
				});
				
				if($remind.val()===null) return false;
				
				return !error;
			}
			
